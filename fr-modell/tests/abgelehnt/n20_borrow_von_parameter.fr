// erwartet: Fehler R-5.23 in der mit FEHLER markierten Zeile
// ohne Typprüfung: Fehlerzustand
// Der Loan gilt nur für den Empfänger p, nicht für a. Ohne die Regel könnte a
// ersetzt werden, während r noch auf das alte Objekt zeigt.
class A {
    int v;
    int get() ro { return copy this.v; }
    int inc() mut { this.v = copy this.v + 1; return 0; }
    destructor() { print(copy this.v); }
}
class Box {
    own A first;
    ref A front() ro { return &ro this.first; }
}
class Pick {
    ref A pick(ref A x) ro { return &ro x; } // FEHLER
}
main {
    own Pick p = new Pick();
    own A a = new A(1);
    borrow r = p.pick(&ro a) {
        a = new A(2);
        print(r.get());
    }
}
