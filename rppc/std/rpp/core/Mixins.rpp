// Standardbibliothek: rpp.core, Mixins der Sprache (Kapitel 13, R-13.6 bis R-13.9)
package rpp.core;

export mixin Equatable<T> {
    nodiscard bool equals(T other);
}

export mixin Comparable<T> {
    import Equatable<T>;
    nodiscard i32 compareTo(T other);
    bool less(T other) { return compareTo(other) < 0; }
}

export mixin Hashable {
    nodiscard i64 hash();
}

export mixin Iterable<T, C> {
    nodiscard C begin();
    nodiscard bool done(C cursor);
    nodiscard C next(C cursor);
    ref T at(C cursor);

    nodiscard bool any(Func<T, bool> predicate) {
        for (T item : this) {
            if (predicate(item)) { return true; }
        }
        return false;
    }

    nodiscard bool all(Func<T, bool> predicate) {
        for (T item : this) {
            if (!predicate(item)) { return false; }
        }
        return true;
    }

    nodiscard A fold<A>(own A acc, Func<own A, T, A> step) {
        for (T item : this) {
            acc = step(acc, item);
        }
        return acc;
    }

    nodiscard U[] mapNotNull<U>(Func<T, U?> transform) {
        U[] result = [];
        for (T item : this) {
            U? value = transform(item);
            if (value != null) {
                result.push(value);
            }
        }
        return result;
    }
}

export mixin MutIterable<T, C> {
    import Iterable<T, C>;
    ref T& atMut(C cursor) &;
}
