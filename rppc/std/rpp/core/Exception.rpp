// Standardbibliothek: rpp.core, Exceptions (Kapitel 9, R-9.4; Kapitel 13, R-13.5)
package rpp.core;

export class Exception {
public:
    string message;
    Exception? cause;
    Exception[] suppressed = [];
    constructor(string message) {
        this.message = message;
    }
    constructor(string message, own Exception cause) {
        this.message = message;
        this.cause = cause;
    }
    virtual string describe() {
        return message;
    }
}

export class FormatException : Exception {
public:
    constructor(string message) : base(message) { }
}

export class IOException : Exception {
public:
    string path;
    constructor(string message, string path) : base(message) {
        this.path = path;
    }
}

export class ArgumentException : Exception {
public:
    constructor(string message) : base(message) { }
}
