// Standardbibliothek: rpp.collections (Kapitel 13, R-13.17, R-13.18)
// Die Rümpfe sind Platzhalter; die Implementierung folgt mit dem Interpreter (M4, M5).
package rpp.collections;

export class Entry<K, V> {
public:
    K key;
    V value;
    constructor(own K key, own V value) {
        this.key = key;
        this.value = value;
    }
}

export class Map<K : Hashable & Equatable<K>, V> {
    import Iterable<Entry<K, V>, i64>;
public:
    constructor() { }
    nodiscard i64 length() { fail("eingebaut"); }
    nodiscard bool contains(K key) { fail("eingebaut"); }
    ref V? get(K key) { fail("eingebaut"); }
    ref mut V at(K key) mut { fail("eingebaut"); }
    // Ausbau (R-13.33): liefert den Wert zum Schlüssel; fehlt er, wird
    // factory() eingesetzt. Eingebaut, damit auch own-Schlüssel gehen.
    ref mut V getOrPut(own K key, Func<V> factory) mut { fail("eingebaut"); }
    void put(own K key, own V value) mut { fail("eingebaut"); }
    V? remove(K key) mut { fail("eingebaut"); }
    void clear() mut { fail("eingebaut"); }
    nodiscard i64 begin() { fail("eingebaut"); }
    nodiscard bool done(i64 cursor) { fail("eingebaut"); }
    nodiscard i64 next(i64 cursor) { fail("eingebaut"); }
    ref Entry<K, V> at(i64 cursor) { fail("eingebaut"); }
}

export class Set<T : Hashable & Equatable<T>> {
    import Iterable<T, i64>;
    import Equatable<Set<T>>;
private:
    // Übernimmt einen bereits auf Eindeutigkeit geprüften Eintrag in die Ergebnismenge.
    void appendEntry(Set<T> source, i64 cursor) mut { fail("eingebaut"); }
public:
    constructor() { }
    void add(own T x) mut { fail("eingebaut"); }
    nodiscard bool contains(T x) { fail("eingebaut"); }
    void remove(T x) mut { fail("eingebaut"); }
    void clear() mut { fail("eingebaut"); }
    nodiscard i64 length() { fail("eingebaut"); }
    nodiscard i64 begin() { fail("eingebaut"); }
    nodiscard bool done(i64 cursor) { fail("eingebaut"); }
    nodiscard i64 next(i64 cursor) { fail("eingebaut"); }
    ref T at(i64 cursor) { fail("eingebaut"); }

    nodiscard bool equals(Set<T> other) {
        if (length() != other.length()) { return false; }
        for (T x : this) {
            if (!other.contains(x)) { return false; }
        }
        return true;
    }

    nodiscard Set<T> intersect(Set<T> other) {
        Set<T> result = new Set<T>();
        for (i64 i = 0; i < length(); i++) {
            if (other.contains(at(i))) { result.appendEntry(this, i); }
        }
        return result;
    }

    nodiscard Set<T> unite(Set<T> other) {
        Set<T> result = new Set<T>();
        for (i64 i = 0; i < length(); i++) { result.appendEntry(this, i); }
        for (i64 i = 0; i < other.length(); i++) {
            if (!contains(other.at(i))) { result.appendEntry(other, i); }
        }
        return result;
    }

    nodiscard Set<T> subtract(Set<T> other) {
        Set<T> result = new Set<T>();
        for (i64 i = 0; i < length(); i++) {
            if (!other.contains(at(i))) { result.appendEntry(this, i); }
        }
        return result;
    }
}
