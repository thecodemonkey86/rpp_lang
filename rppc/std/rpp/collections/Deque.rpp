// Standardbibliothek: rpp.collections, Deque (Kapitel 13, R-13.32)
// Reiner R++-Quelltext (V-13.9): vektorbasiert. Operationen am Anfang sind
// linear (insert/remove an Index 0); für die Referenz genügt das (V-13.10).
package rpp.collections;

export class Deque<T> {
    import Iterable<T, i64>;
private:
    T[] items;
    // bleibt null: front/back geben bei leerer Deque einen Borrow darauf zurück,
    // denn eine Borrow-Methode gibt nur Orte zurück, die von this ausgehen (R-5.23)
    T? none = null;
public:
    constructor() { items = []; }

    nodiscard i64 length() { return items.length; }
    nodiscard bool isEmpty() { return items.length == 0; }

    void pushBack(own T x) mut { items.push(x); }
    void pushFront(own T x) mut { items.insert(0, x); }
    own T popBack() mut { return items.pop(); }
    own T popFront() mut { return items.remove(0); }

    ref T? front() {
        if (items.length == 0) { return this.none; }
        return this.items[0];
    }
    ref T? back() {
        if (items.length == 0) { return this.none; }
        return this.items[items.length - 1];
    }
    void clear() mut { items.clear(); }

    nodiscard i64 begin() { return 0; }
    nodiscard bool done(i64 cursor) { return cursor >= items.length; }
    nodiscard i64 next(i64 cursor) { return cursor + 1; }
    ref T at(i64 cursor) { return items[cursor]; }
}
