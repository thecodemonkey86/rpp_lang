package rpp.json;

using rpp.text.StringBuilder;

class JsonCursor {
private:
    char[] input = [];
    i64 position = 0;

    i64 readHex4() mut {
        i64 value = 0;
        for (i32 i = 0; i < 4; i++) {
            i64 code = cast<i64>(peek());
            i64 digit = 0;
            if (code >= 48 && code <= 57) { digit = code - 48; }
            else if (code >= 65 && code <= 70) { digit = code - 65 + 10; }
            else if (code >= 97 && code <= 102) { digit = code - 97 + 10; }
            else { throw error("Expected a hexadecimal digit in Unicode escape"); }
            advance();
            value = value * 16 + digit;
        }
        return value;
    }

    char readUnicode() mut {
        i64 startLine = line;
        i64 startColumn = column;
        i64 first = readHex4();
        if (first >= 0xD800 && first <= 0xDBFF) {
            expect('\\', "Expected a low surrogate escape");
            expect('u', "Expected a low surrogate escape");
            i64 lowLine = line;
            i64 lowColumn = column;
            i64 second = readHex4();
            if (second < 0xDC00 || second > 0xDFFF) {
                throw new JsonParseException("Expected a low surrogate", lowLine, lowColumn);
            }
            return cast<char>(0x10000 + (first - 0xD800) * 1024 + second - 0xDC00);
        }
        if (first >= 0xDC00 && first <= 0xDFFF) {
            throw new JsonParseException("Unexpected low surrogate", startLine, startColumn);
        }
        return cast<char>(first);
    }

    char readEscape() mut {
        char c = peek();
        if (c == 'u') {
            advance();
            return readUnicode();
        }
        char decoded = '\0';
        switch (c) {
            case '"': decoded = '"'; break;
            case '\\': decoded = '\\'; break;
            case '/': decoded = '/'; break;
            case 'b': decoded = cast<char>(8); break;
            case 'f': decoded = cast<char>(12); break;
            case 'n': decoded = '\n'; break;
            case 'r': decoded = '\r'; break;
            case 't': decoded = '\t'; break;
            default: throw error("Invalid JSON escape");
        }
        advance();
        return decoded;
    }

    void digits() mut {
        if (!isDigit(peek())) { throw error("Expected a digit"); }
        while (isDigit(peek())) { advance(); }
    }

public:
    i64 line = 1;
    i64 column = 1;

    constructor(string text) {
        for (char c : text) { input.push(c); }
    }

    bool atEnd() { return position == input.length; }

    char peek() { return atEnd() ? '\0' : input[position]; }

    void advance() mut {
        char c = input[position];
        if (c == '\r') {
            line++;
            column = 1;
        } else if (c == '\n') {
            if (position == 0 || input[position - 1] != '\r') { line++; }
            column = 1;
        } else {
            column++;
        }
        position++;
    }

    JsonParseException error(string message) {
        return new JsonParseException(message, line, column);
    }

    bool eat(char c) mut {
        if (atEnd() || peek() != c) { return false; }
        advance();
        return true;
    }

    void expect(char c, string message) mut {
        if (!eat(c)) { throw error(message); }
    }

    void skipWhitespace() mut {
        while (true) {
            char c = peek();
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { return; }
            advance();
        }
    }

    void literal(string text) mut {
        for (char c : text) { expect(c, "Expected '" + text + "'"); }
    }

    string readString() mut {
        expect('"', "Expected a JSON string");
        StringBuilder text = new StringBuilder();
        while (!atEnd()) {
            char c = peek();
            if (c == '"') {
                advance();
                return text.toString();
            }
            if (cast<i64>(c) < 32) { throw error("Unescaped control character in JSON string"); }
            advance();
            if (c == '\\') { c = readEscape(); }
            text.appendChar(c);
        }
        throw error("Unterminated JSON string");
    }

    static bool isDigit(char c) {
        i64 code = cast<i64>(c);
        return code >= 48 && code <= 57;
    }

    string readNumber() mut {
        i64 start = position;
        if (peek() == '-') { advance(); }
        if (eat('0')) {
            if (isDigit(peek())) { throw error("Leading zero in JSON number"); }
        } else {
            digits();
        }
        if (eat('.')) { digits(); }
        char exponent = peek();
        if (exponent == 'e' || exponent == 'E') {
            advance();
            char sign = peek();
            if (sign == '+' || sign == '-') { advance(); }
            digits();
        }
        StringBuilder text = new StringBuilder();
        for (i64 i = start; i < position; i++) { text.appendChar(input[i]); }
        return text.toString();
    }
}
