package rpp.text;

export class StringBuilder {
public:
    constructor() { }
    nodiscard i64 length() { fail("eingebaut"); }
    void append(string s) & { fail("eingebaut"); }
    void appendChar(char c) & { fail("eingebaut"); }
    void appendLine(string s) & { fail("eingebaut"); }
    void clear() & { fail("eingebaut"); }
    nodiscard string toString() { fail("eingebaut"); }
}
