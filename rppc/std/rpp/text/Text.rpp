// Standardbibliothek: rpp.text, Text-Hilfen (Kapitel 13, R-13.30, R-13.40)
// Reiner R++-Quelltext (V-13.9): statische Methoden auf string nach dem Muster
// von Fmt. Beide Compiler behandeln sie gleich (keine M6-Divergenz, V-13.10).
package rpp.text;

export class Text {
public:
    // Zerlegt s in Zeilen: Trenner ist '\n', ein '\r' davor entfällt (CRLF).
    // Leere Zeilen bleiben erhalten; ein abschließendes '\n' erzeugt keine
    // zusätzliche leere Zeile. Für "" ist das Ergebnis ein leerer Vektor.
    static string[] lines(string s) {
        string[] parts = s.split("\n");
        i64 n = parts.length;
        if (n > 0 && parts[n - 1] == "") { n = n - 1; }
        string[] result = [];
        for (i64 i = 0; i < n; i++) {
            result.push(i + 1 < parts.length ? removeSuffix(parts[i], "\r") : parts[i]);
        }
        return result;
    }

    // Entfernt prefix vom Anfang, falls vorhanden; sonst bleibt s unverändert.
    static string removePrefix(string s, string prefix) {
        if (s.startsWith(prefix)) { return s.substring(prefix.length, s.length); }
        return s;
    }

    // Entfernt suffix vom Ende, falls vorhanden; sonst bleibt s unverändert.
    static string removeSuffix(string s, string suffix) {
        if (s.endsWith(suffix)) { return s.substring(0, s.length - suffix.length); }
        return s;
    }

    // Hängt s n-mal aneinander; n >= 0 wird verlangt, sonst Programmfehler.
    static string repeat(string s, i64 n) {
        if (n < 0) { fail("repeat verlangt n >= 0"); }
        StringBuilder sb = new StringBuilder();
        for (i64 i = 0; i < n; i++) { sb.append(s); }
        return sb.toString();
    }

    // Teilt s an sep in höchstens limit Teile; der letzte Teil enthält den
    // ungeteilten Rest. limit >= 1 und ein nicht leerer sep werden verlangt.
    static string[] splitLimit(string s, string sep, i64 limit) {
        if (limit < 1) { fail("splitLimit verlangt limit >= 1"); }
        if (sep.length == 0) { fail("splitLimit verlangt einen nicht leeren Trenner"); }
        string[] all = s.split(sep);
        if (all.length <= limit) { return all; }
        string[] result = [];
        for (i64 i = 0; i < limit - 1; i++) { result.push(all[i]); }
        result.push(string::join(sep, all[limit - 1..]));
        return result;
    }

    // Prüft, ob s leer ist oder nur aus Whitespace besteht (R-13.40).
    static bool isBlank(string s) {
        return s.trim().length == 0;
    }

    // Teil von s vor dem ersten Vorkommen von delimiter; fehlt delimiter,
    // bleibt s unverändert (R-13.40).
    static string substringBefore(string s, string delimiter) {
        string[] parts = splitLimit(s, delimiter, 2);
        if (parts.length == 2) { return parts[0]; }
        return s;
    }

    // Teil von s nach dem ersten Vorkommen von delimiter; fehlt delimiter,
    // ist der Teil leer (R-13.40).
    static string substringAfter(string s, string delimiter) {
        string[] parts = splitLimit(s, delimiter, 2);
        if (parts.length == 2) { return parts[1]; }
        return "";
    }

    // Erster Buchstabe groß, der Rest klein (R-13.40).
    static string capitalize(string s) {
        if (s.length == 0) { return s; }
        return s.substring(0, 1).toUpper() + s.substring(1, s.length).toLower();
    }

    // Gesamte s in Großbuchstaben (R-13.40).
    static string toUpperCase(string s) {
        return s.substring(0, s.length).toUpper();
    }

    // Gesamte s in Kleinbuchstaben (R-13.40).
    static string toLowerCase(string s) {
        return s.substring(0, s.length).toLower();
    }
}
