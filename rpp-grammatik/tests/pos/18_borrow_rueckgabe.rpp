class Table<K : Hashable & Equatable<K>, V> {
public:
    Entry<K, V>[] entries;

    ref V? get(K key) {
        for (Entry<K, V> e : entries) {
            if (e.key == key) {
                return e.value;
            }
        }
        return null;
    }

    ref mut V at(i64 i) mut {
        return mut this.entries[i].value;
    }

    ref Entry<K, V> first() {
        return this.entries[0];
    }

    abstract ref mut V slot(K key) mut;
}

mixin Store<T> {
    ref T top();
}

class Use {
public:
    void demo(mut Table<string, Foo> t) {
        ref Foo? f = t.get("a");
        if (f != null) {
            f.run();
        }
        ref mut Foo g = mut t.at(0);
        g.bump();
        print(t.first().key);
    }
}
