class Buffers {
public:
    static const i32 SIZE = 16;

private:
    i32[4] header;
    f64[SIZE] samples;
    byte[Buffers::SIZE] raw;
    Foo?[3] slots;
    i32[2][3] grid;

public:
    static i32 sum(Slice<i32> values) {
        i32 total = 0;
        for (i32 v : values) { total += v; }
        return total;
    }

    static void fill(mut Slice<i32> values, i32 x) {
        for (i32 i = 0; i < values.length; i++) { values[i] = x; }
    }

    void demo() mut {
        i32[4] fixed = [1, 2, 3, 4];
        i32[] vec = [1, 2, 3];
        vec.push(4);

        Slice<i32> mid = vec[1..3];
        Slice<i32> head = vec[..2];
        Slice<i32> tail = fixed[2..];
        Slice<i32> all = fixed[..];
        Slice<i32> calc = vec[i + 1..vec.length - 1];

        i32 a = sum(fixed);
        i32 b = sum(vec);
        i32 c = sum(vec[1..]);
        fill(mut vec[0..2], 0);
        fill(mut header, 7);

        for (i32 x : fixed[1..3]) { print("x"); }
        i64 n = fixed.length + vec.length + mid.length;
        i32 first = mid[0];
        f64 d = 1.5;
    }
}
