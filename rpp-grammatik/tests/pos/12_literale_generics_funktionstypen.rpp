mixin Comparable {
    i32 compareTo(Comparable other);
}

mixin Printable {
    string toString();
}

class SortedList<T : Comparable & Printable> {
private:
    T[] items;
public:
    void add(own T item) & {
        items.push(item);
    }
}

class Pair<A : Comparable, B : Printable & Comparable> {
}

class Math {
public:
    static const i64 BILLION = 1_000_000_000;
    static const i32 MASK = 0xFF_FF;
    static const f64 PI = 3.141_592_653;
    static const f64 AVOGADRO = 6.022_140_76e23;
    static const f64 EPS = 2.0E-16;
    static const f64 BIG = 1.0e+300;

    static T max<T : Comparable>(T a, T b) {
        if (a.compareTo(b) > 0) { return a; }
        return b;
    }

    static T first<T>(T[] list) {
        return list[0];
    }

    static void each<T, R : Printable>(T[] list, Func<T, void> f) {
        for (T item : list) { f(item); }
    }
}

mixin Sorter {
    void sort<T : Comparable>(T[]& list);
}

abstract class Visitor {
public:
    abstract R visit<R>(Node n);
}

class Demo {
public:
    void run(i32 a, i32 b) {
        i8 small = 100;
        var d = 42;
        var e = 5_000_000_000;
        var f = 3.14;
        i32 m = Math::max(a, b);
        Func<i32, void> log = own (i32 x) => print("x");
        Func<void> tick = own () => { print("tick"); };
        Func<string> name = own () => "name";
        Func<i32, i32, bool> less = own (i32 x, i32 y) => x < y;
        Func<Func<i32, void>, void> apply = own (Func<i32, void> g) => g(1);
        assert(m >= a, "max stimmt nicht");
        const Foo frozen = new Foo();
        const i32 limit = a + b;
    }
}
