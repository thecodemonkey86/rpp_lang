// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: ref-Deklaration (Abschnitt 7)
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (der Initialisierer muss ein Ort sein, kein temporärer Wert).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    Foo make() { return new Foo(1); }
    void m() {
        ref Foo f = make(); // FEHLER
        f.run();
    }
}
