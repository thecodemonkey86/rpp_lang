// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.15 (T-If), V-5
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (a ist in einem Zweig verschoben).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void take(own Foo f) { }
    void m(bool flag) {
        Foo a = new Foo(1);
        if (flag) {
            take(a);
        }
        a.run(); // FEHLER
    }
}
