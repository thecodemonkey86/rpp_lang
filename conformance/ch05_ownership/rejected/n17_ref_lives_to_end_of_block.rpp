// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.17 (T-Borrow), ref-Deklaration
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (first ist bis zum Blockende geliehen).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void m() {
        Foo[] list = [new Foo(1)];
        ref Foo first = list[0];
        first.run();
        list.push(new Foo(2)); // FEHLER
    }
}
