// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-4.41, V-6, V-13
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (weak entsteht nur aus shared; der own-Wert wäre sofort freigegeben).
package conformance.ch05;

class Foo {
public:
    i32 value = 0;
}

class T {
public:
    void m() {
        Foo f = new Foo();
        shared Foo s = new Foo();
        weak Foo ok = s;
        weak Foo w = f; // FEHLER
    }
}
