// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.7, V-3
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (take gibt es nur für nullbare Felder; replace verwenden).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class Holder {
public:
    Foo payload;
    constructor(own Foo p) { this.payload = p; }
    Foo leere() mut {
        return take(mut this.payload); // FEHLER
    }
}
