// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.10 (T-Aufruf)
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (a wird im selben Aufruf verschoben und geliehen).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void combine(own Foo x, Foo y) { }
    void m() {
        Foo a = new Foo(1);
        combine(a, a); // FEHLER
    }
}
