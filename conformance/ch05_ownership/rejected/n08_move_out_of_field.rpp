// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.3 (T-Move), V-3
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (aus einem Feld kann nicht verschoben werden).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class Holder {
public:
    Foo payload;
    constructor(own Foo p) { this.payload = p; }
    void m() mut {
        Foo f = this.payload; // FEHLER
    }
}
