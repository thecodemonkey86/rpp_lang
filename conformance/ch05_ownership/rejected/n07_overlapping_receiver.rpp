// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.10 (T-Aufruf)
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (h ist als Empfänger veränderbar geliehen).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class Holder {
public:
    Foo payload;
    constructor(own Foo p) { this.payload = p; }
    void absorb(mut Foo other) mut { }
}

class T {
public:
    void m() {
        Holder h = new Holder(new Foo(1));
        h.absorb(mut h.payload); // FEHLER
    }
}
