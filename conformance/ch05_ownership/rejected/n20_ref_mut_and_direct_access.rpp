// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.17 (T-Borrow), Exklusivität
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (a ist durch g veränderbar geliehen).
package conformance.ch05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void m() {
        Foo a = new Foo(1);
        ref mut Foo g = mut a;
        a.run(); // FEHLER
        g.bump();
    }
}
