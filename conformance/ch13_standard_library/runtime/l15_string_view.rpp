// Konformitätstest Kapitel 13 – Laufzeit.
// Regel: R-13.13
// Erwartet: Ausgabe "3\n🙂\n2\n🙂ß\n0\n[]\n[ä]\n[]\n[🙂]\n[]"; Exit-Code 0
using rpp.text.StringView;

class Views {
public:
    static StringView part() {
        string source = "x  ä🙂ß  y";
        StringView full = new StringView(source);
        source = "anderer Text";
        return full.slice(1, full.length() - 1).trim();
    }
}

i32 main(string[] args) {
    StringView view = Views::part();
    print(view.length().toString());
    print(view.charAt(1).toString());
    print((view.indexOf("ß") ?? -1).toString());
    print(view.slice(1, 3).toString());
    print(view.slice(3, 3).length().toString());
    StringView list = new StringView("|ä||🙂|");
    for (StringView item : list.split("|")) {
        print("[" + item.toString() + "]");
    }
    return 0;
}
