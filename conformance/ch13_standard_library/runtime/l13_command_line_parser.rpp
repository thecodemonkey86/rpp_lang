// Konformitätstest Kapitel 13 – Laufzeit.
// Erwartet: Ausgabe "tool: missing argument TARGET\ntrue\n--help\ntrue\ntool: unknown option --unknown\ntool: unexpected argument b\nUsage: tool [--long] TARGET\nTest program\n  -h, --help  Show this help\n  --long  Long output"; Exit-Code 0
using rpp.env.CommandLineParser;
using rpp.env.CommandLineResult;

i32 main(string[] args) {
    CommandLineParser p = new CommandLineParser("tool", "Test program");
    p.addFlag("--long", "Long output");
    p.addPositional("TARGET");
    print(p.parse(args).error ?? "-");
    string[] literal = ["--long", "--", "--help"];
    CommandLineResult parsed = p.parse(literal);
    print(parsed.isSet("--long").toString());
    print(parsed.positional[0]);
    string[] help = ["-h"];
    print(p.parse(help).helpRequested.toString());
    string[] unknown = ["--unknown"];
    print(p.parse(unknown).error ?? "-");
    string[] extra = ["a", "b"];
    print(p.parse(extra).error ?? "-");
    print(p.helpText());
    return 0;
}
