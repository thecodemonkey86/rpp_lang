// Konformitätstest Kapitel 13 – Laufzeit.
// Regel: R-13.46
// Erwartet: Ausgabe "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\n9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318\nb35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a\nffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb\ngleich\na8af099bf2e878609558dbf69d8f88f4a31040a8cf84b549a0cfa912f12ffc3f"; Exit-Code 0
using rpp.hash.Sha256;
using rpp.text.Text;

i32 main(string[] args) {
    print(Sha256::hexText(""));
    print(Sha256::hexText("abc"));
    print(Sha256::hexText("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"));
    // 55, 56 und 64 Bytes: die Grenzen der Auffüllung
    print(Sha256::hexText(Text::repeat("a", 55)));
    print(Sha256::hexText(Text::repeat("a", 56)));
    print(Sha256::hexText(Text::repeat("a", 64)));
    // Stückweise wie am Stück; Text als UTF-8
    Sha256 h = new Sha256();
    h.updateText("Grüß ");
    byte[] rest = [cast<byte>(cast<ui8>(0x47)), cast<byte>(cast<ui8>(0x6f)), cast<byte>(cast<ui8>(0x74)), cast<byte>(cast<ui8>(0x74))];
    h.update(rest);
    print(h.finishHex() == Sha256::hexText("Grüß Gott") ? "gleich" : "verschieden");
    byte[] tausend = [];
    for (i32 i = 0; i < 1000; i++) {
        tausend.push(cast<byte>(cast<ui8>(i % 256)));
    }
    print(Sha256::hex(tausend));
    return 0;
}
