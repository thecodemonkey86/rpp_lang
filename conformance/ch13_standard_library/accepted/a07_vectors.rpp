// Konformitätstest Kapitel 13 – muss übersetzt werden.
// Regel: R-13.26, R-13.27, R-13.38, R-13.39
using rpp.collections.Vectors;

class Box {
public:
    string label;
    constructor(string l) { label = l; }
}

i32 main(string[] args) {
    i32[] s = [1, 3, 5];
    i64? f = Vectors::binarySearch(s, 3);
    if (f != null) { print(f.toString()); }
    print(Vectors::equals(s, s) ? "ja" : "nein");

    Box[] boxes = [new Box("a"), new Box("b"), new Box("c")];
    Vectors::reverse(mut boxes);
    Vectors::retain(mut boxes, (Box b) => b.label != "b");

    i32[] nums = [3, 1, 2];
    Vectors::reverse(mut nums);
    Vectors::dedup(mut nums);

    // Elementare Algorithmen: Zählen und Prädikate.
    i32[] nums2 = [1, 2, 3, 4];
    print(Vectors::count(nums2, 2).toString());
    print(Vectors::any(nums2, (i32 x) => x > 2) ? "ja" : "nein");
    print(Vectors::all(nums2, (i32 x) => x > 0) ? "ja" : "nein");
    print(Vectors::none(nums2, (i32 x) => x > 10) ? "ja" : "nein");
    return 0;
}
