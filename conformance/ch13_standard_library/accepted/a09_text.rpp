// Konformitätstest Kapitel 13 – muss übersetzt werden.
// Regel: R-13.30, R-13.40
using rpp.text.Text;

i32 main(string[] args) {
    string[] l = Text::lines("a\nb");
    string p = Text::removePrefix("abc", "a");
    string s = Text::removeSuffix("abc", "c");
    string r = Text::repeat("x", 3);
    string[] parts = Text::splitLimit("a,b,c", ",", 2);
    print(p + s + r);
    print(l.length.toString());
    print(parts.length.toString());

    // Neue Text-Hilfen (R-13.40).
    print(Text::isBlank("  ").toString());
    print(Text::substringBefore("hello world", " "));
    print(Text::substringAfter("hello world", " "));
    print(Text::toUpperCase("abc"));
    print(Text::toLowerCase("ABC"));
    print(Text::capitalize("hELLO"));
    return 0;
}
