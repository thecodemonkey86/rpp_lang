// Konformitätstest Kapitel 13 – muss abgelehnt werden.
// Regel: R-7.26, R-13.18, R-13.8
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Point ist nicht Hashable).
package conformance.ch13;

using rpp.collections.Set;

class Point {
    import Equatable<Point>;
public:
    i32 x = 0;
    bool equals(Point other) { return x == other.x; }
}

class Use {
public:
    void m() {
        Set<Point> s = new Set<Point>(); // FEHLER
    }
}
