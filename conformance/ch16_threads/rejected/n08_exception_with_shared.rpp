// Konformitätstest Kapitel 16 – muss abgelehnt werden.
// Regel: R-16.10, R-9.4
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (eine Exception-Klasse muss übertragbar sein).
package conformance.ch16;

class Counter {
public:
    i64 n = 0;
}

class Failed : Exception {
public:
    shared Counter? counter;   // FEHLER
    constructor(string message) : base(message) {
    }
}
