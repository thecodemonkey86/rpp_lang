// Konformitätstest Kapitel 16 – Laufzeit.
// Regel: R-16.22, R-16.2, R-16.3
// Erwartet: Ausgabe "thread has a\nreleased a\njoined\ngot b\nreleased b\nend"; Exit-Code 0
using rpp.sync.Thread;
using rpp.sync.Task;

class Noisy {
public:
    string name;
    constructor(string name) {
        this.name = name;
    }
    destructor() {
        print("released " + this.name);
    }
}

class Use {
public:
    static void result(own Task<Noisy> t) {
        Noisy b = t.join();
        print("got " + b.name);
    }
}

i32 main(string[] args) {
    // das Objekt gehört dem Thread: sein Destruktor läuft dort, vor der Rückkehr von join
    Noisy n = new Noisy("a");
    Thread t = Thread::spawnWith(n, own (own Noisy x) => {
        print("thread has " + x.name);
    });
    t.join();
    print("joined");
    // ein Ergebnis gehört dem, der es mit join abholt
    Use::result(Thread::spawn(own () => new Noisy("b")));
    print("end");
    return 0;
}
