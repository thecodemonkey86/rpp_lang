// Konformitätstest Kapitel 6 – muss übersetzt werden.
// Regel: R-6.5, R-6.15, R-6.22, R-6.23
package conformance.ch06;

class Node {
public:
    string name;
    Node? child;
    shared Node? next;
    weak Node? parent;
    i32? count;
    Node?[] slots = [];
    constructor(string n) { this.name = n; }
    bool ok() { return true; }
    void run() { }
    void touch() mut { }
}

class T {
public:
    void holen(mut Node n, i64 i) {
        // Der Borrow c gilt bis zum Blockende (Kapitel 5, R-5.17); take braucht das Feld danach frei.
        {
            ref Node? c = n.child;
            if (c != null) {
                c.run();
            }
        }
        shared Node? s = n.next;
        if (s != null) {
            s.run();
        }
        shared Node? p = n.parent?.lock();
        i32? k = n.count;
        if (k != null) {
            i32 doppelt = k * 2;
        }
        ref Node? e = n.slots[i];
        if (e != null) {
            e.run();
        }
        Node? weg = take(mut n.child);
    }
}
