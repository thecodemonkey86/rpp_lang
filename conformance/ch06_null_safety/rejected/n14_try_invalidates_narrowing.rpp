package conformance.ch06;

class Node {
public:
    void run() { }
}

class T {
public:
    void risky() { }

    void m() {
        Node? z = new Node();
        try {
            z = null;
            risky();
        } catch (Exception e) {
            z.run(); // FEHLER
        }
