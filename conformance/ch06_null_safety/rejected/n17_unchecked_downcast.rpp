// Regel: R-6.21, R-4.23
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (as liefert Circle?).
package conformance.ch06;

class Shape {
public:
    virtual f64 area() { return 0.0; }
}

class Circle : Shape {
public:
    f64 r = 1.0;
}

class T {
public:
    f64 m(Shape s) {
        ref Circle? c = s as Circle;
        return c.r; // FEHLER
    }
}
