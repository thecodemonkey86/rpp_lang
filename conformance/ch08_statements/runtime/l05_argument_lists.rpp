// Konformitätstest Kapitel 8 – Laufzeit.
// Regel: R-8.2, R-5.3, R-10.1
// Erwartet: Ausgabe "1234\n12345\n2345\n54321"; Exit-Code 0
class Pack {
public:
    i32 value;
    constructor(i32 a, i32 b, i32 c, i32 d, i32 e) {
        value = a * 10000 + b * 1000 + c * 100 + d * 10 + e;
    }
}

class Call {
public:
    static i32 four(i32 a, i32 b, i32 c, i32 d) {
        return a * 1000 + b * 100 + c * 10 + d;
    }

    static i32 consume(own Pack pack, i32 a, i32 b, i32 c, i32 d) {
        print(pack.value.toString());
        return four(a, b, c, d);
    }
}

i32 main(string[] args) {
    print(Call::four(1, 2, 3, 4).toString());
    Pack pack = new Pack(1, 2, 3, 4, 5);
    print(Call::consume(pack, 2, 3, 4, 5).toString());
    i32 result = ((i32 a, i32 b, i32 c, i32 d, i32 e) =>
        a * 10000 + b * 1000 + c * 100 + d * 10 + e)(5, 4, 3, 2, 1);
    print(result.toString());
    return 0;
}
