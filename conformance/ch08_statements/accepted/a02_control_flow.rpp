// Konformitätstest Kapitel 8 – muss übersetzt werden.
// Regel: R-8.22, R-8.23, R-8.24, R-8.25
package conformance.ch08;

enum Color { Red, Green, Blue }

class Flow {
public:
    i32 demo(Color c, string cmd, i32 code, mut Foo[] list, string text) {
        i32 total = 0;
        for (i32 i = 0; i < 10; i++) {
            switch (code) {
                case 1, 2:
                    total += 1;
                    break;              // beendet das switch, nicht die Schleife
                case 3:
                    continue;           // setzt die Schleife fort
                default:
                    total += 2;
            }
        }
        switch (c) {
            case Color::Red:
                total += 10;
            case Green, Blue:
                total += 20;
        }
        switch (cmd) {
            case "start":
                total += 100;
            default:
                total -= 1;
        }
        do {
            total--;
        } while (total > 50);
        for (char ch : text) {
            if (ch == 'x') {
                break;
            }
        }
        for (Foo f : list) {
            f.run();
        }
        for (mut Foo f : mut list) {
            f.bump();
        }
        while (true) {
            if (total < 0) {
                break;
            }
            total -= 5;
        }
        return total;
    }
}

class Foo {
public:
    i32 v = 0;
    void run() { }
    void bump() mut { v++; }
}
