// Konformitätstest Kapitel 8 – muss übersetzt werden.
// Regel: R-8.21, R-8.26
package conformance.ch08;

class Ret {
public:
    i32 sign(i32 x) {
        if (x > 0) {
            return 1;
        } else if (x < 0) {
            return -1;
        }
        return 0;
    }

    i32 always(bool flag) {
        if (flag) {
            return 1;
        }
        throw new Exception("kein Wert");
    }

    void early(i32 x) {
        if (x < 0) {
            return;
        }
        print("positiv");
    }
}
