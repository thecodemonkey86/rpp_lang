// Konformitätstest Kapitel 8 – muss abgelehnt werden.
// Regel: R-8.24
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Blue fehlt).
package conformance.ch08;

enum Color { Red, Green, Blue }

class T {
public:
    void m(Color c) {
        switch (c) { // FEHLER
            case Red:
                print("rot");
            case Green:
                print("grün");
        }
    }
}
