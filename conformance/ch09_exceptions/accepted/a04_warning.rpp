// Konformitätstest Kapitel 9 – muss übersetzt werden und eine Warnung erzeugen.
// Regel: R-9.7, R-8.27
// Erwartet: genau eine Warnung, in der mit WARNUNG markierten Zeile (catch nach catch der Oberklasse).
package conformance.ch09;
using rpp.core.Exception;

class ParseError : Exception {
public:
    i64 line;
    constructor(string message, i64 line) : base(message) {
        this.line = line;
    }
}

class SyntaxError : ParseError {
public:
    constructor(string message) : base(message, 0) { }
}

class Order {
public:
    void m() {
        try {
            print("x");
        } catch (ParseError e) {
            print("allgemein");
        } catch (SyntaxError e) { // WARNUNG
            print("nie erreicht");
        }
    }
}
