// Konformitätstest Kapitel 9 – muss abgelehnt werden.
// Regel: R-9.8, Kapitel 5 R-5.3
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (e besitzt die Exception und ist an kept übergegangen).
package conformance.ch09;
using rpp.core.Exception;

class ParseError : Exception {
public:
    i64 line;
    constructor(string message, i64 line) : base(message) {
        this.line = line;
    }
}

class SyntaxError : ParseError {
public:
    constructor(string message) : base(message, 0) { }
}

class T {
public:
    void m(bool flag) {
        try {
            print("x");
        } catch (Exception e) {
            Exception kept = e;
            print(e.message); // FEHLER
        }
    }
}
