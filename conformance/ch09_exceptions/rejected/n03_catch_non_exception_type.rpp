// Konformitätstest Kapitel 9 – muss abgelehnt werden.
// Regel: R-9.6
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (string ist keine Exception-Klasse).
package conformance.ch09;
using rpp.core.Exception;

class ParseError : Exception {
public:
    i64 line;
    constructor(string message, i64 line) : base(message) {
        this.line = line;
    }
}

class SyntaxError : ParseError {
public:
    constructor(string message) : base(message, 0) { }
}

class T {
public:
    void m() {
        try {
            print("x");
        } catch (string s) { // FEHLER
            print(s);
        }
    }
}
