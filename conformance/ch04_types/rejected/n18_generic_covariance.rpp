// Konformitätstest Kapitel 4 – muss abgelehnt werden.
// Regel: R-4.43
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Box<Circle> ist kein Box<Shape>).
package conformance.ch04;

class Shape { }
class Circle : Shape { }

class Box<T> {
public:
    T? value;
}

class T {
public:
    void take(Box<Shape> xs) { }
    void m(Box<Circle> cs) {
        take(cs); // FEHLER
    }
}
