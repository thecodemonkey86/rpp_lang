// Konformitätstest Kapitel 4 – muss abgelehnt werden.
// Regel: R-4.36
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (die Elemente von t sind an f und n übergegangen).
package conformance.ch04;

class Foo {
public:
    i32 v = 0;
}

class T {
public:
    (Foo, i32) make() { return (new Foo(), 1); }
    void keep(own (Foo, i32) p) { }

    void demo() {
        (Foo, i32) t = make();
        (Foo f, i32 n) = t;
        keep(t); // FEHLER
    }
}
