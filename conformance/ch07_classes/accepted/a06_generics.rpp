// Konformitätstest Kapitel 7 – muss übersetzt werden.
// Regel: R-7.23, R-7.24, R-7.25, R-7.26, R-7.27, R-7.28, R-4.42, R-4.44
package conformance.ch07;

class Item {
    import Equatable<Item>;
public:
    i32 id = 0;
    bool equals(Item other) { return id == other.id; }
}

class Pool<T : Equatable<T> & new()> {
public:
    T[] items = [];

    static i32 capacity() { return 16; }

    T make() {
        return new T();
    }

    bool contains(T x) {
        for (T y : items) {
            if (y == x) {
                return true;
            }
        }
        return false;
    }
}

class Util {
public:
    static i64 count<T>(T[] xs) { return xs.length; }
}

class Use {
public:
    void demo(i32[] numbers) {
        Pool<Item> pool = new Pool<Item>();
        i32 cap = Pool<Item>::capacity();
        Item fresh = pool.make();
        i64 n = Util::count(numbers);
    }
}
