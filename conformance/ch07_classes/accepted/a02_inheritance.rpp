// Konformitätstest Kapitel 7 – muss übersetzt werden.
// Regel: R-7.12, R-7.13, R-7.14, R-7.15
package conformance.ch07;

abstract class Shape {
public:
    abstract f64 area();
    virtual string describe() { return "Form"; }
}

class Circle : Shape {
public:
    f64 r;
    constructor(f64 r) { this.r = r; }
    override f64 area() { return 3.14 * r * r; }
    override string describe() { return base.describe() + ": Kreis"; }
}

class Ring : Circle {
public:
    constructor(f64 r) : base(r) { }
    override string describe() { return "Ring"; }
}

class Use {
public:
    f64 total(Shape[] shapes) {
        f64 sum = 0.0;
        for (Shape s : shapes) {
            sum += s.area();
        }
        return sum;
    }
}
