// Konformitätstest Kapitel 7 – Laufzeit.
// Regel: R-7.1, R-7.3, R-7.4
// Erwartet: Ausgabe "23:123\n34:134\n23:123\n8\n9"; Exit-Code 0
class Base {
public:
    i32 first = 1;
    i32 second = 2;
    static const i32 offset = 100;

    void advance(i32 step) mut {
        first += step;
        this.second += step;
    }

    i32 total() { return offset + first * 10 + second; }
}

class A : Base {
public:
    i32 extra = 8;
}

class B : Base {
public:
    i32 padding = 0;
    i32 extra = 9;
}

class Read {
public:
    static string describe(Base value) {
        return (value.first * 10 + value.second).toString() + ":" + value.total().toString();
    }
}

i32 main(string[] args) {
    A a = new A();
    B b = new B();
    a.advance(1);
    b.advance(2);
    print(Read::describe(a));
    print(Read::describe(b));
    print(Read::describe(a));
    print(a.extra.toString());
    print(b.extra.toString());
    return 0;
}
