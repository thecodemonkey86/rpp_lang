// Konformitätstest Kapitel 7 – muss abgelehnt werden.
// Regel: R-7.22
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Named hat keine Methode describe).
package conformance.ch07;

mixin Named {
    string name();
}

class Use {
public:
    string m(Named n) {
        return n.describe(); // FEHLER
    }
}
