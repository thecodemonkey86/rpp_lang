// Konformitätstest Kapitel 7 – muss abgelehnt werden.
// Regel: R-7.15
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (base.m() gibt es nur für this).
package conformance.ch07;

class Shape {
public:
    virtual string describe() { return "Form"; }
}

class Circle : Shape {
public:
    override string describe() { return "Kreis"; }
    string other(Circle c) {
        return c.base.describe(); // FEHLER
    }
}
