// Regeln: R-5.9, R-5.10, R-5.17
// erwartet: Ausgabe 2 1 9 9 1 9
class A {
    int v;
    int get() ro { return copy this.v; }
    int inc() mut { this.v = copy this.v + 1; return 0; }
    destructor() { print(copy this.v); }
}
class P {
    own A l;
    own A r;
}
class Ops {
    int swap(mut A x, mut A y) ro {
        int t = copy x.v;
        x.v = copy y.v;
        y.v = copy t;
        return 0;
    }
    int sum(ref A x, ref A y) ro { return copy x.v + copy y.v; }
}
main {
    own Ops o = new Ops();
    own P p = new P(new A(1), new A(2));
    o.swap(&mut p.l, &mut p.r);         // disjunkte Orte
    print(copy p.l.v);
    print(copy p.r.v);
    int s = o.sum(&ro p.l, &ro p.l);    // zwei lesende Borrows auf denselben Ort
    borrow x = &mut p.l {
        x.v = 9;
        print(copy x.v);
    }
    borrow y = &ro p {
        print(copy y.l.v);
    }
}
