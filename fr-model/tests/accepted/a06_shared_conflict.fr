// Regeln: V-1, Abschnitt 5.2
// erwartet: BorrowError
class A {
    int v;
    int get() ro { return copy this.v; }
    int inc() mut { this.v = copy this.v + 1; return 0; }
    destructor() { print(copy this.v); }
}
class Holder {
    shared A s;
    int touch(mut A x) ro {
        shared A t = copy this.s;   // zweiter Verweis auf dasselbe Objekt
        t.inc();                    // das Objekt ist schreibend gesperrt
        return 0;
    }
}
main {
    shared A s = share new A(1);
    own Holder h = new Holder(copy s);
    h.touch(&mut s);
}
