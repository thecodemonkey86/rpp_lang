// Projekte und Quelldateien laden (Kapitel 11): rpp.yaml, Quellordner, Abhängigkeiten,
// die Standardbibliothek. Prüft R-11.13, R-11.15 bis R-11.20 und R-11.26 bis R-11.30
// (Abhängigkeiten aus dem Verzeichnis, rpp.lock). Gleichwertig zu
// rppc/crates/rpp-sema/src/project.rs. Pfade sind absolut und verwenden / (V-13.8).
package compiler.project;

using rpp.io.File;
using rpp.io.Dir;
using rpp.io.DirEntry;
using rpp.io.FileType;
using rpp.io.Path;
using rpp.env.Env;
using rpp.env.Os;
using rpp.collections.Set;
using rpp.collections.Map;
using compiler.lexer.Lexer;
using compiler.syntax.Node;
using compiler.syntax.Source;
using compiler.syntax.SyntaxError;

export enum ProjectKind {
    Executable,
    Library,
}

export class Project {
public:
    string name;
    ProjectKind kind;
    string dir;
    // direkte Abhängigkeiten (Indizes in Workspace.projects); die Standardbibliothek zählt nicht
    i64[] deps = [];
    bool isStd = false;
    // Einzeldatei-Test ohne rpp.yaml
    bool singleFile = false;
    // Datei mit main laut rpp.yaml
    string? mainFile = null;
    string? yaml = null;
    // gewählte Version einer Bibliothek aus dem Verzeichnis (R-11.19)
    string? registryVersion = null;
    // native: true (R-15.13): das Projekt darf extern-Klassen deklarieren
    bool native = false;
    // nativePaths (R-15.4): Ordner, in denen C-Bibliotheken zuerst gesucht werden
    string[] nativePaths = [];
    // je Eintrag in deps: Zeile der Abhängigkeit und ob allowNative: true gesetzt ist (R-15.14)
    i32[] depLines = [];
    bool[] depAllow = [];
    // bringt C-Code mit (R-15.14, V-15.8): native oder eine Abhängigkeit mit C-Code
    bool bringsC = false;

    constructor(string name, ProjectKind kind, string dir) {
        this.name = name;
        this.kind = kind;
        this.dir = dir;
    }
}

export class SourceFile {
public:
    string path;
    i64 project;
    Node unit;
    // Paket laut Verzeichnis (R-11.2); null bei Einzeldateien
    string? expected;

    constructor(string path, i64 project, own Node unit, string? expected) {
        this.path = path;
        this.project = project;
        this.unit = unit;
        this.expected = expected;
    }

    // Paket laut Deklaration; "" ohne package
    string packageName() {
        if (unit.kids.length == 0 || unit.kids[0].kind != "package") {
            return "";
        }
        string[] parts = [];
        for (Node id : unit.kids[0].kids[0].kids) {
            parts.push(id.text);
        }
        return string::join(".", parts);
    }

    // Namen der Klassen, Mixins und Enums, mit Komma getrennt; "-" ohne
    string typeNames() {
        Func<Node, string?> typeName = own (Node d) =>
            d.kind == "class" || d.kind == "handle" || d.kind == "mixin" || d.kind == "enum" ? d.kids[0].text : null;
        string[] names = unit.mapNotNull(typeName);
        if (names.length == 0) {
            return "-";
        }
        return string::join(",", names);
    }

    bool hasMain() {
        return unit.any((Node d) => d.kind == "main");
    }
}

// Eine Meldung: Fehler oder Warnung mit Regelnummer (wie Diag in rppc)
export class Diag {
public:
    string file;
    i32 line;
    i32 col;
    string rule;
    string message;
    bool warning = false;
    // weitere Regeln, die den Fehler genauer begründen
    string[] also = [];

    constructor(string file, i32 line, i32 col, string rule, string message) {
        this.file = file;
        this.line = line;
        this.col = col;
        this.rule = rule;
        this.message = message;
    }
}

// Eine Abhängigkeit mit version (R-11.15, R-11.19)
class Req {
public:
    string yaml;
    i32 line;
    string name;
    string min;

    constructor(string yaml, i32 line, string name, string min) {
        this.yaml = yaml;
        this.line = line;
        this.name = name;
        this.min = min;
    }
}

// Ein Platz in Project.deps, der auf eine Bibliothek aus dem Verzeichnis zeigt
class Link {
public:
    i64 project;
    i64 slot;
    string name;
    string yaml;
    i32 line;

    constructor(i64 project, i64 slot, string name, string yaml, i32 line) {
        this.project = project;
        this.slot = slot;
        this.name = name;
        this.yaml = yaml;
        this.line = line;
    }
}

export class Workspace {
public:
    Project[] projects = [];
    SourceFile[] files = [];
    Diag[] diags = [];
    // Releasemodus: Symbol release statt debug (R-11.24)
    bool release = false;
    // Anzahl der nummerierten Knoten aller Dateien (Node.id)
    i64 nodeCount = 0;
    // Bibliotheken aus dem Verzeichnis mit Version und Prüfsumme, nach Namen sortiert
    string[] resolvedNames = [];
    string[] resolvedVersions = [];
    string[] resolvedSums = [];
    // native je gewählter Bibliothek (R-15.15)
    bool[] resolvedNative = [];

    // Lädt eine einzelne .rpp-Datei oder ein Verzeichnis mit rpp.yaml; die
    // Standardbibliothek kommt aus stdDir.
    static Workspace load(string input, string stdDir, bool release) {
        return loadWith(input, stdDir, release, false);
    }

    // Für den Befehl lock: löst ohne die vorhandene rpp.lock auf (R-11.30)
    static Workspace loadForLock(string input, string stdDir) {
        return loadWith(input, stdDir, false, true);
    }

    // Für publish: mit einem vorgegebenen Verzeichnis statt registry und RPP_REGISTRY
    static Workspace loadIn(string input, string stdDir, string registry) {
        Workspace ws = new Workspace();
        ws.registryOverride = registry;
        ws.ignoreLock = true;
        ws.loadStd(stdDir);
        discard ws.loadProject(Path::absolute(input), mut new Set<string>(), false, "", "", 0);
        ws.resolve();
        return ws;
    }

private:
    // Anforderungen version aus dem Programm und seinen lokalen Abhängigkeiten
    Req[] reqs = [];
    Link[] links = [];
    // registry aus der rpp.yaml des Programms: Datei, Zeile, Pfad (null: kein Text)
    bool hasRegistryEntry = false;
    string registryYaml = "";
    i32 registryLine = 0;
    string? registryText = null;
    // lädt gerade eine Bibliothek aus dem Verzeichnis
    bool inRegistry = false;
    string? expectVersion = null;
    bool ignoreLock = false;
    string? registryOverride = null;

    // Platzhalter in Project.deps, bis die Bibliothek aus dem Verzeichnis geladen ist
    static const i64 PENDING = -1;

    static Workspace loadWith(string input, string stdDir, bool release, bool ignoreLock) {
        Workspace ws = new Workspace();
        ws.release = release;
        ws.ignoreLock = ignoreLock;
        ws.loadStd(stdDir);
        string path = Path::absolute(input);
        if (Dir::exists(path)) {
            Set<string> stack = new Set<string>();
            discard ws.loadProject(path, mut stack, false, "", "", 0);
            ws.resolve();
            ws.checkNative();
            return ws;
        }
        i64 idx = ws.projects.length;
        string name = Path::fileName(path);
        string ext = Path::extension(path);
        if (ext.length > 0) {
            name = name.substring(0, name.length - ext.length - 1);
        }
        Path parent = new Path(Path::join(path, ".."));
        Project p = new Project(name, ProjectKind::Library, parent.toString());
        p.singleFile = true;
        ws.projects.push(p);
        string[] none = [];
        ws.parseFile(path, idx, null, none);
        i64 n = ws.files.length;
        if (n > 0 && ws.files[n - 1].project == idx && ws.files[n - 1].hasMain()) {
            ws.projects[idx].kind = ProjectKind::Executable;
            ws.projects[idx].mainFile = path;
        }
        return ws;
    }

    void diag(string file, i32 line, string rule, string message) mut {
        diags.push(new Diag(file, line, 0, rule, message));
    }

    static string hostOs() {
        Os os = Env::os();
        if (os == Os::Windows) {
            return "windows";
        }
        if (os == Os::MacOS) {
            return "macos";
        }
        return "linux";
    }

    static bool contains(string[] list, string s) {
        for (string x : list) {
            if (x == s) {
                return true;
            }
        }
        return false;
    }

    void loadStd(string stdDir) mut {
        i64 idx = projects.length;
        Project p = new Project("rpp", ProjectKind::Library, Path::absolute(stdDir));
        p.isStd = true;
        projects.push(p);
        string[] none = [];
        loadSources(Path::absolute(stdDir), idx, none);
    }

    void parseFile(string path, i64 project, string? expected, string[] symbols) mut {
        string source = "";
        try {
            File f = File::open(path);
            source = f.readAllText();
        } catch (Exception e) {
            diag(path, 1, "R-11.1", "Could not read file: " + e.message);
            return;
        }
        Set<string> syms = new Set<string>();
        if (release) {
            syms.add("release");
        } else {
            syms.add("debug");
        }
        syms.add(hostOs());
        for (string s : symbols) {
            syms.add(s);
        }
        try {
            Node unit = Source::parse(source, syms);
            nodeCount = Node::number(mut unit, nodeCount);
            files.push(new SourceFile(path, project, unit, expected));
        } catch (SyntaxError e) {
            diags.push(new Diag(path, e.line, e.col, "Syntax", e.message));
        }
    }

    // Alle .rpp-Dateien unter dir, sortiert; Unterordner mit eigener rpp.yaml gehören nicht dazu
    static void collectRpp(string dir, mut string[] out) {
        DirEntry[] entries = [];
        try {
            entries = Dir::entries(dir);
        } catch (Exception e) {
            return;
        }
        for (DirEntry entry : entries) {
            string p = entry.path;
            if (entry.kind == FileType::Directory || (entry.kind == FileType::Symlink && Dir::exists(p))) {
                if (!File::exists(Path::join(p, "rpp.yaml"))) {
                    collectRpp(p, mut out);
                }
            } else if ((entry.kind == FileType::File || entry.kind == FileType::Symlink) && Path::extension(entry.name) == "rpp") {
                out.push(p);
            }
        }
    }

    void loadSources(string src, i64 project, string[] symbols) mut {
        string[] found = [];
        collectRpp(src, mut found);
        Path sourceRoot = new Path(src);
        for (string f : found) {
            Path file = new Path(f);
            Path? relative = file.relativeTo(sourceRoot);
            string pkg = "";
            if (relative != null) {
                pkg = Path::parent(relative.toString()).replace("/", ".");
            }
            parseFile(f, project, pkg, symbols);
        }
    }

    // Lädt ein Projekt mit seinen lokalen Abhängigkeiten; -1, wenn es nicht geladen werden
    // kann. stack enthält die Projekte, deren Abhängigkeiten gerade geladen werden (R-11.16).
    // Bei einer Abhängigkeit (expected) ist want der erwartete Name und wantFile:wantLine
    // die Stelle in der rpp.yaml, die sie einträgt.
    i64 loadProject(string dirIn, mut Set<string> stack, bool expected, string want, string wantFile, i32 wantLine) mut {
        string dir = Path::absolute(dirIn);
        for (i64 i = 0; i < projects.length; i++) {
            if (!projects[i].isStd && projects[i].dir == dir) {
                return i;
            }
        }
        string yamlPath = Path::join(dir, "rpp.yaml");
        string text = "";
        try {
            File f = File::open(yamlPath);
            text = f.readAllText();
        } catch (Exception e) {
            if (expected) {
                diag(wantFile, wantLine, "R-11.15", dir + " does not contain rpp.yaml");
            }
            return -1;
        }
        YNode doc = new YNode(YKind::Map, "", 1);
        try {
            doc = Yaml::parse(text);
        } catch (YamlError e) {
            diag(yamlPath, e.line, "R-11.13", e.message);
            return -1;
        }
        string[] known = ["name", "version", "type", "main", "sources", "dependencies", "registry", "symbols", "native", "nativePaths"];
        for (i64 i = 0; i < doc.keys.length; i++) {
            if (!contains(known, doc.keys[i])) {
                diag(yamlPath, doc.items[i].line, "R-11.13", "Unknown entry '" + doc.keys[i] + "'");
            }
        }
        string[] required = ["name", "version", "type", "sources"];
        for (string key : required) {
            if (!doc.has(key)) {
                diag(yamlPath, 1, "R-11.13", "Missing entry '" + key + "'");
            }
        }
        if (doc.has("version")) {
            i32 vl = doc.lineOf("version");
            string? found = doc.isStrAt("version") ? Registry::parse(doc.strOf("version")) : null;
            string? wantVersion = expectVersion;
            if (found == null) {
                diag(yamlPath, vl, "R-11.27", "version must have the form MAJOR.MINOR.PATCH");
            } else if (wantVersion != null && wantVersion != found) {
                diag(yamlPath, vl, "R-11.26", "The library in " + dir + " has version " + found + ", expected " + wantVersion);
            }
        }
        string name = doc.strOf("name");
        i32 nameLine = doc.lineOf("name");
        if (name == "rpp" || name.startsWith("rpp.")) {
            diag(yamlPath, nameLine, "R-11.17", "The owner name rpp is reserved for the standard library");
        } else {
            Lexer words = new Lexer("");
            bool bad = false;
            for (string part : name.split(".")) {
                if (part.length == 0 || words.isKeyword(part)) {
                    bad = true;
                }
            }
            if (bad) {
                diag(yamlPath, nameLine, "R-11.17", "Invalid name '" + name + "'");
            }
        }
        if (expected && want != name) {
            diag(wantFile, wantLine, "R-11.15", "The project in " + dir + " is named '" + name + "', expected '" + want + "'");
        }
        ProjectKind kind = ProjectKind::Library;
        if (doc.has("type")) {
            string t = doc.strOf("type");
            if (doc.isStrAt("type") && t == "executable") {
                kind = ProjectKind::Executable;
            } else if (!doc.isStrAt("type") || t != "library") {
                diag(yamlPath, doc.lineOf("type"), "R-11.13", "type must be executable or library");
            }
        }
        string? mainFile = null;
        if (doc.isStrAt("main")) {
            mainFile = Path::absolute(Path::join(dir, doc.strOf("main")));
        }
        if (kind == ProjectKind::Executable && mainFile == null) {
            diag(yamlPath, 1, "R-11.13", "An executable requires a main entry");
        }
        i64 idx = projects.length;
        Project p = new Project(name, kind, dir);
        p.mainFile = mainFile;
        p.yaml = yamlPath;
        projects.push(p);
        // R-15.13: native, R-15.4: nativePaths
        if (doc.has("native")) {
            if (doc.isStrAt("native") && doc.strOf("native") == "true") {
                projects[idx].native = true;
            } else if (!doc.isStrAt("native") || doc.strOf("native") != "false") {
                diag(yamlPath, doc.lineOf("native"), "R-11.13", "native must be true or false");
            }
        }
        i64 npi = doc.indexOf("nativePaths");
        if (npi >= 0) {
            if (doc.items[npi].kind != YKind::List) {
                diag(yamlPath, doc.items[npi].line, "R-11.13", "nativePaths must be a list of directories");
            } else {
                for (YNode np : doc.items[npi].items) {
                    if (np.kind == YKind::Str) {
                        projects[idx].nativePaths.push(Path::absolute(Path::join(dir, np.text)));
                    } else {
                        diag(yamlPath, np.line, "R-11.13", "An entry of nativePaths must be a path");
                    }
                }
            }
        }
        if (idx == 1 && !inRegistry && doc.has("registry")) {
            hasRegistryEntry = true;
            registryYaml = yamlPath;
            registryLine = doc.lineOf("registry");
            registryText = doc.isStrAt("registry") ? doc.strOf("registry") : null;
        }

        stack.add(dir);
        i64[] deps = [];
        i32[] depLines = [];
        bool[] depAllow = [];
        i64 di = doc.indexOf("dependencies");
        if (di >= 0 && doc.items[di].kind != YKind::List) {
            diag(yamlPath, doc.items[di].line, "R-11.13", "dependencies must be a list");
        }
        if (di >= 0 && doc.items[di].kind == YKind::List) {
            for (YNode dep : doc.items[di].items) {
                string depName = dep.strOf("name");
                bool allow = false;
                if (dep.has("allowNative")) {
                    if (dep.isStrAt("allowNative") && dep.strOf("allowNative") == "true") {
                        allow = true;
                    } else if (!dep.isStrAt("allowNative") || dep.strOf("allowNative") != "false") {
                        diag(yamlPath, dep.lineOf("allowNative"), "R-11.13", "allowNative must be true or false");
                    }
                }
                i64 before = deps.length;
                if (inRegistry && dep.has("path")) {
                    // schon bei der Auflösung gemeldet (R-11.27)
                    continue;
                }
                if (dep.has("path")) {
                    i32 pl = dep.lineOf("path");
                    if (!dep.isStrAt("path")) {
                        diag(yamlPath, pl, "R-11.15", "path must be a file path");
                        continue;
                    }
                    string target = Path::absolute(Path::join(dir, dep.strOf("path")));
                    if (stack.contains(target)) {
                        diag(yamlPath, pl, "R-11.16", "Dependency cycle through '" + depName + "'");
                        continue;
                    }
                    i64 d = loadProject(target, mut stack, true, depName, yamlPath, pl);
                    if (d >= 0) {
                        if (projects[d].kind != ProjectKind::Library) {
                            diag(yamlPath, pl, "R-11.15", "'" + depName + "' is not a library");
                        }
                        deps.push(d);
                    }
                } else if (dep.has("version")) {
                    i32 vl = dep.lineOf("version");
                    string? min = dep.isStrAt("version") ? Registry::parseMin(dep.strOf("version")) : null;
                    if (min != null) {
                        if (!inRegistry) {
                            reqs.push(new Req(yamlPath, vl, depName, min));
                        }
                        links.push(new Link(idx, deps.length, depName, yamlPath, vl));
                        deps.push(PENDING);
                    } else if (!inRegistry) {
                        diag(yamlPath, vl, "R-11.27", "Invalid version in dependency '" + depName + "'");
                    }
                } else {
                    diag(yamlPath, dep.line, "R-11.15", "A dependency requires path or version");
                }
                if (deps.length > before) {
                    depLines.push(dep.line);
                    depAllow.push(allow);
                }
            }
        }
        stack.remove(dir);
        projects[idx].deps = deps;
        projects[idx].depLines = depLines;
        projects[idx].depAllow = depAllow;

        string[] symbols = [];
        string mode = "debug";
        if (release) {
            mode = "release";
        }
        i64 si = doc.indexOf("symbols");
        if (si >= 0) {
            ref YNode syms = doc.items[si];
            if (syms.kind != YKind::Map) {
                diag(yamlPath, syms.line, "R-11.13", "symbols must map debug and release to lists");
            }
            for (i64 k = 0; k < syms.keys.length; k++) {
                string key = syms.keys[k];
                ref YNode list = syms.items[k];
                bool allStr = list.kind == YKind::List && list.all((YNode s) => s.kind == YKind::Str);
                if (key != "debug" && key != "release") {
                    diag(yamlPath, list.line, "R-11.13", "Unknown mode '" + key + "'");
                } else if (!allStr) {
                    diag(yamlPath, list.line, "R-11.13", key + " must be a list of symbols");
                } else if (key == mode) {
                    string[] empty = [];
                    symbols = list.fold(empty, (own string[] names, YNode s) => {
                        names.push(s.text);
                        return names;
                    });
                }
            }
        }
        i64 sx = doc.indexOf("sources");
        if (sx >= 0 && doc.items[sx].kind != YKind::List) {
            diag(yamlPath, doc.items[sx].line, "R-11.13", "sources must be a list of source directories");
        }
        if (sx >= 0 && doc.items[sx].kind == YKind::List) {
            for (YNode s : doc.items[sx].items) {
                if (s.kind != YKind::Str) {
                    diag(yamlPath, s.line, "R-11.13", "A source directory must be a path");
                    continue;
                }
                string src = Path::join(dir, s.text);
                if (!Dir::exists(src)) {
                    diag(yamlPath, s.line, "R-11.13", "Source directory " + src + " is missing");
                    continue;
                }
                loadSources(Path::absolute(src), idx, symbols);
            }
        }
        return idx;
    }

    // Das Verzeichnis des Programms (R-11.26); meldet einen Fehler, wenn es fehlt.
    string? registryDir(string reqYaml, i32 reqLine) mut {
        string? forced = registryOverride;
        if (forced != null) {
            return forced;
        }
        if (hasRegistryEntry) {
            string ry = registryYaml;
            i32 rl = registryLine;
            string? text = registryText;
            if (text == null) {
                diag(ry, rl, "R-11.26", "registry must be a directory path");
                return null;
            }
            string d = Path::absolute(Path::join(projects[1].dir, text));
            if (Dir::exists(d)) {
                return d;
            }
            diag(ry, rl, "R-11.26", "Registry directory " + d + " does not exist");
            return null;
        }
        string? env = Env::get("RPP_REGISTRY");
        if (env != null && env.length > 0) {
            string d = Path::absolute(env);
            if (Dir::exists(d)) {
                return d;
            }
            diag(reqYaml, reqLine, "R-11.26", "Registry directory " + d + " (RPP_REGISTRY) does not exist");
            return null;
        }
        diag(reqYaml, reqLine, "R-11.26", "No registry: set registry in rpp.yaml or the environment variable RPP_REGISTRY");
        return null;
    }

    // Wählt die Bibliotheken aus dem Verzeichnis (R-11.19, R-11.28), prüft rpp.lock
    // (R-11.20, R-11.30), lädt die gewählten Versionen und verknüpft die Abhängigkeiten.
    void resolve() mut {
        if (projects.length < 2) {
            return;
        }
        string lockPath = Path::join(projects[1].dir, "rpp.lock");
        bool hasLock = false;
        LockEntry[] lock = [];
        if (!ignoreLock && File::exists(lockPath)) {
            try {
                File f = File::open(lockPath);
                lock = Registry::parseLock(f.readAllText());
                hasLock = true;
            } catch (LockError e) {
                diag(lockPath, e.line, "R-11.20", e.message);
                dropPending();
                return;
            } catch (Exception e) {
                diag(lockPath, 1, "R-11.20", "Could not read rpp.lock: " + e.message);
                dropPending();
                return;
            }
        }
        Req[] empty = [];
        Req[] queue = replace(mut reqs, empty);
        Set<string> local = new Set<string>();
        for (Project p : projects) {
            if (!p.isStd) {
                local.add(p.name);
            }
        }
        string? reg = null;
        bool regFailed = false;
        Map<string, i64> major = new Map<string, i64>();
        Map<string, string> firstYaml = new Map<string, string>();
        Map<string, i32> firstLine = new Map<string, i32>();
        string[] order = [];
        Map<string, string> selected = new Map<string, string>();
        Set<string> visited = new Set<string>();
        Set<string> failed = new Set<string>();
        // Bibliotheken, die irgendeine Anforderung nennt (auch wenn sie scheitert)
        Set<string> requested = new Set<string>();
        i64 qi = 0;
        while (qi < queue.length) {
            string reqYaml = queue[qi].yaml;
            i32 reqLine = queue[qi].line;
            string name = queue[qi].name;
            string min = queue[qi].min;
            qi++;
            if (reg == null) {
                reg = registryDir(reqYaml, reqLine);
                if (reg == null) {
                    regFailed = true;
                    break;
                }
            }
            string regDir = reg ?? "";
            if (name == "rpp" || name.startsWith("rpp.")) {
                diag(reqYaml, reqLine, "R-11.17", "The owner name rpp is reserved for the standard library");
                continue;
            }
            if (!Registry::validName(name)) {
                diag(reqYaml, reqLine, "R-11.17", "'" + name + "': a library from the registry is named owner.name");
                continue;
            }
            if (local.contains(name)) {
                diag(reqYaml, reqLine, "R-11.15", "'" + name + "' is both a local dependency and one from the registry");
                continue;
            }
            requested.add(name);
            i64 m = major.get(name) ?? -1;
            if (m >= 0 && m != Registry::major(min)) {
                diag(reqYaml, reqLine, "R-11.19", "'" + name + "' is required in major versions " + m.toString()
                    + " and " + Registry::major(min).toString());
                continue;
            }
            if (m < 0) {
                major.put(name, Registry::major(min));
            }
            string libDir = Path::join(regDir, name);
            string node = "";
            if (hasLock) {
                i64 found = -1;
                for (i64 k = 0; k < lock.length; k++) {
                    if (lock[k].name == name) {
                        found = k;
                    }
                }
                if (found < 0) {
                    diag(reqYaml, reqLine, "R-11.20", "rpp.lock does not list '" + name + "'; run the lock command");
                    continue;
                }
                string v = lock[found].version;
                if (Registry::major(v) != Registry::major(min) || Registry::compare(v, min) < 0) {
                    diag(reqYaml, reqLine, "R-11.20", "rpp.lock is out of date: '" + name + "' " + v + " does not satisfy "
                        + min + "; run the lock command");
                    continue;
                }
                if (!Dir::exists(Path::join(libDir, v))) {
                    diag(reqYaml, reqLine, "R-11.26", "'" + name + "' " + v + " is not in the registry");
                    continue;
                }
                node = v;
            } else {
                if (!Dir::exists(libDir)) {
                    diag(reqYaml, reqLine, "R-11.26", "Library '" + name + "' is not in the registry");
                    continue;
                }
                for (string v : Registry::versions(libDir)) {
                    if (node.length == 0 && !Registry::withdrawn(libDir, v) && Registry::major(v) == Registry::major(min)
                        && Registry::compare(v, min) >= 0) {
                        node = v;
                    }
                }
                if (node.length == 0) {
                    diag(reqYaml, reqLine, "R-11.19", "No version of '" + name + "' satisfies " + min
                        + " (same major version, not withdrawn)");
                    continue;
                }
            }
            if (!firstYaml.contains(name)) {
                firstYaml.put(name, reqYaml);
                firstLine.put(name, reqLine);
                order.push(name);
            }
            string? sel = selected.get(name);
            if (sel == null || Registry::compare(node, sel) > 0) {
                selected.put(name, node);
            }
            string key = name + "@" + node;
            if (visited.contains(key)) {
                continue;
            }
            visited.add(key);
            string nodeDir = Path::absolute(Path::join(libDir, node));
            string yamlPath = Path::join(nodeDir, "rpp.yaml");
            string text = "";
            try {
                File f = File::open(yamlPath);
                text = f.readAllText();
            } catch (Exception e) {
                diag(reqYaml, reqLine, "R-11.26", nodeDir + " does not contain rpp.yaml");
                failed.add(key);
                continue;
            }
            YNode doc = new YNode(YKind::Map, "", 1);
            try {
                doc = Yaml::parse(text);
            } catch (YamlError e) {
                diag(yamlPath, e.line, "R-11.13", e.message);
                failed.add(key);
                continue;
            }
            i64 di = doc.indexOf("dependencies");
            if (di >= 0 && doc.items[di].kind == YKind::List) {
                for (YNode dep : doc.items[di].items) {
                    string depName = dep.strOf("name");
                    if (dep.has("path")) {
                        diag(yamlPath, dep.lineOf("path"), "R-11.27", "A library from the registry cannot have path dependencies");
                    } else if (dep.has("version")) {
                        i32 vl = dep.lineOf("version");
                        string? depMin = dep.isStrAt("version") ? Registry::parseMin(dep.strOf("version")) : null;
                        if (depMin != null) {
                            queue.push(new Req(yamlPath, vl, depName, depMin));
                        } else {
                            diag(yamlPath, vl, "R-11.27", "Invalid version in dependency '" + depName + "'");
                        }
                    }
                }
            }
        }
        if (hasLock && !regFailed) {
            for (LockEntry e : lock) {
                if (!requested.contains(e.name)) {
                    diag(lockPath, e.line, "R-11.20", "rpp.lock lists '" + e.name + "', which is not needed; run the lock command");
                }
            }
        }
        if (reg == null) {
            dropPending();
            return;
        }
        string regDir = reg ?? "";
        Map<string, i64> index = new Map<string, i64>();
        Map<string, string> sums = new Map<string, string>();
        Map<string, bool> natives = new Map<string, bool>();
        for (string name : order) {
            string v = selected.get(name) ?? "";
            if (failed.contains(name + "@" + v)) {
                continue;
            }
            string dir = Path::join(Path::join(regDir, name), v);
            inRegistry = true;
            expectVersion = v;
            Set<string> stack = new Set<string>();
            i64 i = loadProject(dir, mut stack, true, name, firstYaml.get(name) ?? "", firstLine.get(name) ?? 0);
            inRegistry = false;
            expectVersion = null;
            if (i < 0) {
                continue;
            }
            projects[i].registryVersion = v;
            index.put(name, i);
            string pdir = projects[i].dir;
            try {
                string sum = Registry::checksum(pdir);
                bool native = projects[i].native;
                for (LockEntry e : lock) {
                    if (e.name == name && e.checksum != sum) {
                        diag(lockPath, e.checksumLine, "R-11.20", "The checksum of '" + name + "' " + v
                            + " does not match rpp.lock: the library has changed");
                    } else if (e.name == name && e.native != native) {
                        diag(lockPath, e.line, "R-15.15", "rpp.lock and '" + name + "' " + v
                            + " disagree about native; run the lock command");
                    }
                }
                sums.put(name, sum);
                natives.put(name, native);
                resolvedNames.push(name);
            } catch (Exception e) {
                diag(Path::join(pdir, "rpp.yaml"), 1, "R-11.29", "Could not compute the checksum: " + e.message);
            }
        }
        resolvedNames.sort();
        for (string name : resolvedNames) {
            resolvedVersions.push(selected.get(name) ?? "");
            resolvedSums.push(sums.get(name) ?? "");
            resolvedNative.push(natives.get(name) ?? false);
        }
        Link[] noLinks = [];
        Link[] all = replace(mut links, noLinks);
        for (Link l : all) {
            i64 d = index.get(l.name) ?? -1;
            if (d >= 0) {
                projects[l.project].deps[l.slot] = d;
                if (projects[d].kind != ProjectKind::Library) {
                    diag(l.yaml, l.line, "R-11.15", "'" + l.name + "' is not a library");
                }
            }
        }
        // R-11.16 im Verzeichnis: Zyklen über Abhängigkeiten mit version
        Map<i64, i32> state = new Map<i64, i32>();
        for (string name : order) {
            i64 p = index.get(name) ?? -1;
            if (p >= 0) {
                cycles(p, all, mut state);
            }
        }
        dropPending();
    }

    void cycles(i64 p, Link[] all, mut Map<i64, i32> state) mut {
        if ((state.get(p) ?? 0) != 0) {
            return;
        }
        state.put(p, 1);
        for (i64 slot = 0; slot < projects[p].deps.length; slot++) {
            i64 d = projects[p].deps[slot];
            if (d == PENDING || projects[d].registryVersion == null) {
                continue;
            }
            i32 st = state.get(d) ?? 0;
            if (st == 1) {
                for (Link l : all) {
                    if (l.project == p && l.slot == slot) {
                        diag(l.yaml, l.line, "R-11.16", "Dependency cycle through '" + l.name + "'");
                    }
                }
                projects[p].deps[slot] = PENDING;
            } else if (st == 0) {
                cycles(d, all, mut state);
            }
        }
        state.put(p, 2);
    }

    void dropPending() mut {
        links.clear();
        for (i64 i = 0; i < projects.length; i++) {
            i64[] kept = [];
            i32[] keptLines = [];
            bool[] keptAllow = [];
            for (i64 k = 0; k < projects[i].deps.length; k++) {
                i64 d = projects[i].deps[k];
                if (d != PENDING) {
                    kept.push(d);
                    keptLines.push(k < projects[i].depLines.length ? projects[i].depLines[k] : 0);
                    keptAllow.push(k < projects[i].depAllow.length && projects[i].depAllow[k]);
                }
            }
            projects[i].deps = kept;
            projects[i].depLines = keptLines;
            projects[i].depAllow = keptAllow;
        }
    }

    // R-15.14, V-15.8: Welche Projekte bringen C-Code mit, und hat jede Abhängigkeit auf ein
    // solches Projekt allowNative: true?
    void checkNative() mut {
        i64 n = projects.length;
        // Projekt, aus dem der C-Code stammt; -1: keiner. Bis zum Fixpunkt rechnen, weil
        // Abhängigkeiten auf früher oder später geladene Projekte zeigen.
        i64[] source = [];
        for (i64 p = 0; p < n; p++) {
            source.push(projects[p].native ? p : -1);
        }
        bool changed = true;
        while (changed) {
            changed = false;
            for (i64 p = 0; p < n; p++) {
                if (source[p] >= 0) {
                    continue;
                }
                for (i64 d : projects[p].deps) {
                    if (d >= 0 && d < n && source[d] >= 0) {
                        source[p] = source[d];
                        changed = true;
                        break;
                    }
                }
            }
        }
        for (i64 p = 0; p < n; p++) {
            projects[p].bringsC = source[p] >= 0;
        }
        for (i64 p = 0; p < n; p++) {
            string? yaml = projects[p].yaml;
            if (yaml == null) {
                continue;
            }
            for (i64 k = 0; k < projects[p].deps.length; k++) {
                i64 d = projects[p].deps[k];
                i32 line = k < projects[p].depLines.length ? projects[p].depLines[k] : 1;
                bool allow = k < projects[p].depAllow.length && projects[p].depAllow[k];
                string name = projects[d].name;
                i64 s = source[d];
                if (s >= 0 && !allow) {
                    string origin = s == d ? "" : " (through '" + projects[s].name + "')";
                    diag(yaml, line, "R-15.14", "'" + name + "' brings C code" + origin + "; allow it with allowNative: true");
                } else if (s < 0 && allow) {
                    Diag w = new Diag(yaml, line, 0, "R-15.14", "allowNative is set, but '" + name + "' brings no C code");
                    w.warning = true;
                    diags.push(w);
                }
            }
        }
    }
}
