// Zustand der Flussanalyse, gleichwertig zu rppc/crates/rpp-sema/src/flow.rs: Typverengung
// (Kapitel 6), sichere Initialisierung (R-4.46), Moves (Kapitel 5) und Loans.
// Mengen und Zuordnungen über Variablennummern sind sortierte Listen.
package compiler.sema;

// Menge von Variablennummern (sortiert)
export class IdSet {
public:
    i64[] items = [];

    // erste Position mit einem Wert >= x (binäre Suche in einer sortierten Liste)
    static i64 lowerBound(i64[] xs, i64 x) {
        i64 lo = 0;
        i64 hi = xs.length;
        while (lo < hi) {
            i64 mid = (lo + hi) / 2;
            if (xs[mid] < x) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return lo;
    }

    bool has(i64 x) {
        i64 at = lowerBound(items, x);
        return at < items.length && items[at] == x;
    }

    void add(i64 x) mut {
        i64 at = lowerBound(items, x);
        if (at < items.length && items[at] == x) {
            return;
        }
        items.insert(at, x);
    }

    // entfernt x; true, wenn es enthalten war
    bool remove(i64 x) mut {
        i64 at = lowerBound(items, x);
        if (at < items.length && items[at] == x) {
            discard items.remove(at);
            return true;
        }
        return false;
    }

    IdSet dup() {
        IdSet c = new IdSet();
        c.items = copy(items);
        return c;
    }

    bool same(IdSet o) {
        if (items.length != o.items.length) {
            return false;
        }
        for (i64 i = 0; i < items.length; i++) {
            if (items[i] != o.items[i]) {
                return false;
            }
        }
        return true;
    }

    // Zusammenführen der sortierten Listen: mode 0 Schnitt, 1 Vereinigung, 2 a ohne b
    static IdSet merge(IdSet a, IdSet b, i32 mode) {
        IdSet c = new IdSet();
        i64 i = 0;
        i64 j = 0;
        i64 na = a.items.length;
        i64 nb = b.items.length;
        while (i < na || j < nb) {
            if (j >= nb || (i < na && a.items[i] < b.items[j])) {
                if (mode != 0) {
                    c.items.push(a.items[i]);
                }
                i++;
            } else if (i >= na || b.items[j] < a.items[i]) {
                if (mode == 1) {
                    c.items.push(b.items[j]);
                }
                j++;
            } else {
                if (mode != 2) {
                    c.items.push(a.items[i]);
                }
                i++;
                j++;
            }
        }
        return c;
    }

    static IdSet inter(IdSet a, IdSet b) {
        return merge(a, b, 0);
    }

    static IdSet unite(IdSet a, IdSet b) {
        return merge(a, b, 1);
    }

    // a ohne b
    static IdSet minus(IdSet a, IdSet b) {
        return merge(a, b, 2);
    }
}

// Zuordnung Variablennummer → Regel (sortiert nach Nummer)
export class IdMap {
public:
    i64[] keys = [];
    string[] vals = [];

    i64 find(i64 k) {
        i64 at = IdSet::lowerBound(keys, k);
        if (at < keys.length && keys[at] == k) {
            return at;
        }
        return -1;
    }

    bool has(i64 k) {
        return find(k) >= 0;
    }

    void put(i64 k, string v) mut {
        i64 at = IdSet::lowerBound(keys, k);
        if (at < keys.length && keys[at] == k) {
            vals[at] = v;
            return;
        }
        keys.insert(at, k);
        vals.insert(at, v);
    }

    // entfernt k und liefert seinen Wert; "" , wenn es fehlte
    string take(i64 k) mut {
        i64 i = find(k);
        if (i < 0) {
            return "";
        }
        discard keys.remove(i);
        return vals.remove(i);
    }

    IdMap dup() {
        IdMap c = new IdMap();
        c.keys = copy(keys);
        c.vals = copy(vals);
        return c;
    }

    // Vereinigung in einem Durchlauf über beide sortierten Listen; bei gleichem Schlüssel gilt
    // der Wert aus b. Ist single nicht leer, bekommt ein Eintrag, der nur in einer der beiden
    // steht und den Wert "R-5.3" hat, stattdessen single (Moves, die nur auf einem Weg geschahen).
    static IdMap unite(IdMap a, IdMap b, string single) {
        IdMap c = new IdMap();
        i64 i = 0;
        i64 j = 0;
        i64 na = a.keys.length;
        i64 nb = b.keys.length;
        while (i < na || j < nb) {
            if (j >= nb || (i < na && a.keys[i] < b.keys[j])) {
                c.keys.push(a.keys[i]);
                if (single != "" && a.vals[i] == "R-5.3") {
                    c.vals.push(single);
                } else {
                    c.vals.push(a.vals[i]);
                }
                i++;
            } else if (i >= na || b.keys[j] < a.keys[i]) {
                c.keys.push(b.keys[j]);
                if (single != "" && b.vals[j] == "R-5.3") {
                    c.vals.push(single);
                } else {
                    c.vals.push(b.vals[j]);
                }
                j++;
            } else {
                c.keys.push(b.keys[j]);
                c.vals.push(b.vals[j]);
                i++;
                j++;
            }
        }
        return c;
    }

    // Zuordnung jeder Nummer aus ids zu v
    static IdMap uniform(IdSet ids, string v) {
        IdMap c = new IdMap();
        for (i64 x : ids.items) {
            c.keys.push(x);
            c.vals.push(v);
        }
        return c;
    }

    bool sameKeys(IdMap o) {
        if (keys.length != o.keys.length) {
            return false;
        }
        for (i64 i = 0; i < keys.length; i++) {
            if (keys[i] != o.keys[i]) {
                return false;
            }
        }
        return true;
    }
}

export class Flow {
public:
    // nicht erreichbar (nach return, throw, break, continue, fail)
    bool dead = false;
    // Kopie beim Schreiben (M7): Die vier Mengen sind geteilt und werden nie verändert.
    // dup teilt sie; jede Änderung läuft über die Methoden unten (addNonnull, putMoved, …),
    // die die Menge durch eine veränderte Kopie ersetzen, und nur, wenn sich etwas ändert.
    // verengte nullbare Variablen (R-6.5)
    shared IdSet nonnull = new IdSet();
    // warum eine Variable nicht (mehr) verengt ist
    shared IdMap lost = new IdMap();
    // möglicherweise noch nicht zugewiesen (R-4.46)
    shared IdSet unassigned = new IdSet();
    // möglicherweise verschoben, mit der Regel, die den Move begründet
    shared IdMap moved = new IdMap();

    static Flow deadFlow() {
        Flow f = new Flow();
        f.dead = true;
        return f;
    }

    Flow dup() {
        Flow c = new Flow();
        c.dead = dead;
        c.nonnull = nonnull;
        c.lost = lost;
        c.unassigned = unassigned;
        c.moved = moved;
        return c;
    }

    // Vereinigung zweier Stände; nullRule begründet den Verlust einer Verengung, die nur
    // auf einem Weg galt, moveRule einen Move, der nur auf einem Weg geschah.
    Flow join(Flow o, string nullRule, string moveRule) {
        if (dead) {
            return o.dup();
        }
        if (o.dead) {
            return dup();
        }
        Flow r = new Flow();
        r.nonnull = IdSet::inter(nonnull, o.nonnull);
        // lost: o.lost, darüber lost, darüber nullRule für jede Verengung, die nur auf einem
        // Weg galt (wie flow.rs: Kopie plus put je Eintrag, hier in je einem Durchlauf)
        IdSet oneSided = IdSet::unite(IdSet::minus(nonnull, o.nonnull), IdSet::minus(o.nonnull, nonnull));
        IdMap both = IdMap::unite(o.lost, lost, "");
        if (oneSided.items.length == 0) {
            r.lost = both;
        } else {
            r.lost = IdMap::unite(both, IdMap::uniform(oneSided, nullRule), "");
        }
        // moved: o.moved, darüber moved; ein Move nach R-5.3, der nur auf einem Weg geschah,
        // bekommt moveRule
        r.moved = IdMap::unite(o.moved, moved, moveRule);
        r.unassigned = IdSet::unite(unassigned, o.unassigned);
        return r;
    }

    // gleiche Fakten (für den Fixpunkt an Schleifenköpfen)
    bool same(Flow o) {
        return dead == o.dead && nonnull.same(o.nonnull) && unassigned.same(o.unassigned) && moved.sameKeys(o.moved);
    }

    void narrow(IdSet ids) mut {
        if (!dead) {
            for (i64 x : ids.items) {
                addNonnull(x);
            }
        }
    }

    void unnarrow(i64 id, string rule) mut {
        if (removeNonnull(id) || !lost.has(id)) {
            putLost(id, rule);
        }
    }

    // ------------------------------------------------------------ Änderungen (Kopie beim Schreiben)

    void addNonnull(i64 x) mut {
        if (!nonnull.has(x)) {
            IdSet n = nonnull.dup();
            n.add(x);
            nonnull = n;
        }
    }

    bool removeNonnull(i64 x) mut {
        if (!nonnull.has(x)) {
            return false;
        }
        IdSet n = nonnull.dup();
        discard n.remove(x);
        nonnull = n;
        return true;
    }

    void addUnassigned(i64 x) mut {
        if (!unassigned.has(x)) {
            IdSet n = unassigned.dup();
            n.add(x);
            unassigned = n;
        }
    }

    bool removeUnassigned(i64 x) mut {
        if (!unassigned.has(x)) {
            return false;
        }
        IdSet n = unassigned.dup();
        discard n.remove(x);
        unassigned = n;
        return true;
    }

    void putLost(i64 k, string v) mut {
        i64 at = lost.find(k);
        if (at >= 0 && lost.vals[at] == v) {
            return;
        }
        IdMap m = lost.dup();
        m.put(k, v);
        lost = m;
    }

    // entfernt k und liefert seinen Wert; "", wenn es fehlte
    string takeLost(i64 k) mut {
        if (!lost.has(k)) {
            return "";
        }
        IdMap m = lost.dup();
        string v = m.take(k);
        lost = m;
        return v;
    }

    void putMoved(i64 k, string v) mut {
        i64 at = moved.find(k);
        if (at >= 0 && moved.vals[at] == v) {
            return;
        }
        IdMap m = moved.dup();
        m.put(k, v);
        moved = m;
    }

    string takeMoved(i64 k) mut {
        if (!moved.has(k)) {
            return "";
        }
        IdMap m = moved.dup();
        string v = m.take(k);
        moved = m;
        return v;
    }
}

// Ein Ort: eine Variable mit Feldnamen; "[]" steht für ein Element. Wurzel -1 ist this.
export class Place {
public:
    i64 root;
    string[] path = [];
    constructor(i64 root) {
        this.root = root;
    }
    Place child(string name) {
        Place p = new Place(root);
        for (string s : path) {
            p.path.push(s);
        }
        p.path.push(name);
        return p;
    }
    Place dup() {
        Place p = new Place(root);
        for (string s : path) {
            p.path.push(s);
        }
        return p;
    }
    bool prefixOf(Place o) {
        if (path.length > o.path.length) {
            return false;
        }
        for (i64 i = 0; i < path.length; i++) {
            if (path[i] != o.path[i]) {
                return false;
            }
        }
        return true;
    }
}

// Wie lange ein Loan besteht
export enum UntilKind {
    // bis zum Ende des Blocks dieser Tiefe
    Block,
    // bis zum Ende der Anweisung dieser Tiefe
    Stmt,
    // bis zum Ende dieses Aufrufs
    Call,
}

// Ein aktiver Borrow
export class Loan {
public:
    bool mutable;
    Place place;
    // Die Wurzel ist eine shared-Variable: Dann überlappen alle Orte mit dieser Wurzel.
    bool sharedRoot;
    UntilKind until;
    i64 depth;
    // Regel, gegen die ein Zugriff während des Loans verstößt
    string rule;
    // Name des Orts für Meldungen
    string what;

    constructor(bool mutable, own Place place, bool sharedRoot, UntilKind until, i64 depth, string rule, string what) {
        this.mutable = mutable;
        this.place = place;
        this.sharedRoot = sharedRoot;
        this.until = until;
        this.depth = depth;
        this.rule = rule;
        this.what = what;
    }

    Loan dup() {
        return new Loan(mutable, place.dup(), sharedRoot, until, depth, rule, what);
    }

    // erlaubt_L(κ, p) für diesen einen Loan
    bool conflicts(bool m, Place p) {
        if (!m && !mutable) {
            return false;
        }
        return p.root == place.root && (sharedRoot || p.prefixOf(place) || place.prefixOf(p));
    }
}
