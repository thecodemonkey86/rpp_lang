// Knoten des Syntaxbaums. Der Baum ist einheitlich aufgebaut: Art, Text, Position,
// Kinder. Seine Textform (dump) ist dieselbe wie die von rppc/crates/rpp-syntax/src/dump.rs.
package compiler.syntax;

using rpp.text.StringBuilder;

export class Node {
    import Iterable<Node, i64>;
public:
    i64 begin() { return 0; }
    bool done(i64 cursor) { return cursor >= kids.length; }
    i64 next(i64 cursor) { return cursor + 1; }
    ref Node at(i64 cursor) { return this.kids[cursor]; }

    string kind;
    string text;
    // 0: ohne Position
    i32 line;
    i32 col;
    Node[] kids = [];
    // Nummer im Arbeitsbereich (für die Angaben der Prüfung, Kapitel M6); -1: ohne
    i64 id = -1;

    constructor(string kind, string text, i32 line, i32 col) {
        this.kind = kind;
        this.text = text;
        this.line = line;
        this.col = col;
    }

    // Nummeriert den Baum in Vorordnung ab next; liefert die nächste freie Nummer
    static i64 number(mut Node n, i64 next) {
        n.id = next;
        i64 k = next + 1;
        for (mut Node c : mut n.kids) {
            k = number(mut c, k);
        }
        return k;
    }

    void add(own Node n) mut {
        kids.push(n);
    }

    // Eine Zeile je Knoten: Einrückung, Art, Text, @zeile:spalte
    void dump(mut StringBuilder out, i32 depth) {
        for (i32 i = 0; i < depth; i++) {
            out.append("  ");
        }
        out.append(kind);
        if (text.length > 0) {
            out.append(" ");
            out.append(text);
        }
        if (line > 0) {
            out.append(" @" + line.toString() + ":" + col.toString());
        }
        out.appendChar('\n');
        for (Node k : kids) {
            k.dump(mut out, depth + 1);
        }
    }
}
