// Parser für R++, gleichwertig zu rppc/crates/rpp-syntax/src/parser.rs: rekursiver Abstieg,
// Vorrangparser für Ausdrücke. Wo die Grammatik zwischen Alternativen mit unbegrenzter
// Vorausschau entscheidet, werden die Alternativen in ihrer Reihenfolge probiert; ein
// Fehlschlag ist eine ParseFail-Exception, danach wird die Position zurückgesetzt.
// Gemeldet wird der Fehler, der am weitesten im Quelltext liegt.
package compiler.syntax;

using compiler.lexer.Token;
using compiler.lexer.Kind;
using compiler.lexer.Sym;
using compiler.lexer.Syms;

export class ParseFail : Exception {
public:
    constructor() : base("Syntax error") { }
}

export class Parser {
private:
    Token[] toks;
    i64 pos = 0;
    // weitester Fehler: Position (Token) und was dort erwartet wurde; -1 solange keiner. Die
    // Meldung entsteht erst in error() (sie hängt nur vom Token an farPos ab).
    i64 farPos = -1;
    string farExpected = "";
    // Text je Sym (für Meldungen) und welche Syms einfache Typen sind
    string[] symTexts = Syms::texts();
    bool[] primSyms = [];

    // ------------------------------------------------------------ Hilfen

    i64 idx(i64 offset) {
        i64 i = pos + offset;
        if (i >= toks.length) {
            return toks.length - 1;
        }
        return i;
    }

    i32 line() {
        return toks[pos].line;
    }

    i32 col() {
        return toks[pos].col;
    }

    // pos liegt immer in toks (bump hält vor dem letzten Token an); die Abfragen an der
    // aktuellen Stelle greifen deshalb direkt zu, ohne idx.
    // Schlüsselwörter und Satzzeichen tragen ein Sym (M7-Nachtrag): ein Vergleich statt Art
    // und Text. isP und isK unterscheiden sich nur im Namen.
    bool isPAt(i64 offset, Sym p) {
        i64 i = pos + offset;
        if (i >= toks.length) {
            i = toks.length - 1;
        }
        return toks[i].sym == p;
    }

    bool isP(Sym p) {
        return toks[pos].sym == p;
    }

    bool isKAt(i64 offset, Sym k) {
        i64 i = pos + offset;
        if (i >= toks.length) {
            i = toks.length - 1;
        }
        return toks[i].sym == k;
    }

    bool isK(Sym k) {
        return toks[pos].sym == k;
    }

    bool isIdent(i64 offset) {
        i64 i = pos + offset;
        if (i >= toks.length) {
            i = toks.length - 1;
        }
        return toks[i].kind == Kind::Ident;
    }

    bool isPrim(i64 offset) {
        i64 i = idx(offset);
        return primSyms[cast<i64>(toks[i].sym)];
    }

    bool atEof() {
        return toks[pos].kind == Kind::Eof;
    }

    void bump() mut {
        if (pos < toks.length - 1) {
            pos++;
        }
    }

    bool eatP(Sym p) mut {
        if (toks[pos].sym == p) {
            if (pos < toks.length - 1) {
                pos++;
            }
            return true;
        }
        return false;
    }

    bool eatK(Sym k) mut {
        if (toks[pos].sym == k) {
            if (pos < toks.length - 1) {
                pos++;
            }
            return true;
        }
        return false;
    }

    string shownAt(i64 at) {
        ref Token t = toks[at];
        switch (t.kind) {
            case Str: return "'\"" + t.text + "\"'";
            case Char: return "''" + t.text + "''";
            case Eof: return "end of file";
            default: return "'" + t.text + "'";
        }
    }

    // Fehlschlag festhalten und die Exception liefern, die der Aufrufer wirft.
    ParseFail failure(string expected) mut {
        noteFailure(expected);
        return new ParseFail();
    }

    // Hält einen Fehlschlag an der aktuellen Stelle fest (wie failure, ohne Exception)
    void noteFailure(string expected) mut {
        if (farPos < pos) {
            farPos = pos;
            farExpected = expected;
        }
    }

    void expectP(Sym p) mut {
        if (!eatP(p)) {
            string what = "'" + symTexts[cast<i64>(p)] + "'";
            throw failure(what);
        }
    }

    void expectK(Sym k) mut {
        if (!eatK(k)) {
            string what = "'" + symTexts[cast<i64>(k)] + "'";
            throw failure(what);
        }
    }

    static Node node(string kind, string text) {
        return new Node(kind, text, 0, 0);
    }

    static string flag(string acc, bool on, string word) {
        if (!on) {
            return acc;
        }
        if (acc.length == 0) {
            return word;
        }
        return acc + " " + word;
    }

    Node ident() mut {
        i64 i = pos;
        if (toks[i].kind == Kind::Ident) {
            Node n = new Node("id", toks[i].text, toks[i].line, toks[i].col);
            bump();
            return n;
        }
        throw failure("name");
    }

    Node qualifiedName() mut {
        Node q = node("qname", "");
        q.add(ident());
        while (isP(Sym::Dot) && isIdent(1)) {
            bump();
            q.add(ident());
        }
        return q;
    }

    // ------------------------------------------------------------ Dateien

    Node mainDecl() mut {
        Node m = new Node("main", "", line(), col());
        expectK(Sym::I32);
        if (!isIdent(0) || toks[pos].text != "main") {
            throw failure("'main'");
        }
        bump();
        expectP(Sym::LParen);
        expectK(Sym::String);
        expectP(Sym::LBracket);
        expectP(Sym::RBracket);
        m.add(ident());
        expectP(Sym::RParen);
        m.add(block());
        return m;
    }

    Node typeDecl() mut {
        bool exp = eatK(Sym::Export);
        i32 l = line();
        i32 c = col();
        if (isK(Sym::Abstract) || isK(Sym::Class)) {
            bool abs = eatK(Sym::Abstract);
            expectK(Sym::Class);
            Node n = new Node("class", flag(flag("", exp, "export"), abs, "abstract"), l, c);
            n.add(ident());
            n.add(typeParamsOpt());
            if (eatP(Sym::Colon)) {
                Node b = node("base", "");
                b.add(typeName(false));
                n.add(b);
            }
            expectP(Sym::LBrace);
            Node ms = node("members", "");
            while (!eatP(Sym::RBrace)) {
                ms.add(classMember());
            }
            n.add(ms);
            return n;
        }
        if (eatK(Sym::Mixin)) {
            Node n = new Node("mixin", flag("", exp, "export"), l, c);
            n.add(ident());
            n.add(typeParamsOpt());
            expectP(Sym::LBrace);
            Node ms = node("members", "");
            while (!eatP(Sym::RBrace)) {
                ms.add(mixinMember());
            }
            n.add(ms);
            return n;
        }
        if (eatK(Sym::Enum)) {
            Node n = new Node("enum", flag("", exp, "export"), l, c);
            n.add(ident());
            expectP(Sym::LBrace);
            Node vs = node("variants", "");
            vs.add(enumVariant());
            while (true) {
                if (eatP(Sym::RBrace)) {
                    break;
                }
                expectP(Sym::Comma);
                if (eatP(Sym::RBrace)) {
                    break;
                }
                vs.add(enumVariant());
            }
            n.add(vs);
            return n;
        }
        throw failure("type declaration");
    }

    Node enumVariant() mut {
        Node name = ident();
        if (eatP(Sym::LParen)) {
            Node ps = paramList();
            expectP(Sym::RParen);
            Node v = node("variant", "");
            v.add(name);
            v.add(ps);
            return v;
        }
        if (eatP(Sym::Assign)) {
            bool neg = eatP(Sym::Minus);
            i64 i = pos;
            if (toks[i].kind != Kind::Int) {
                throw failure("integer");
            }
            string value = toks[i].text;
            if (neg) {
                value = "-" + value;
            }
            bump();
            Node v = node("variant", "= " + value);
            v.add(name);
            return v;
        }
        Node v = node("variant", "");
        v.add(name);
        return v;
    }

    Node typeParamsOpt() mut {
        Node ps = node("tparams", "");
        if (eatP(Sym::Lt)) {
            while (true) {
                Node p = node("tparam", "");
                p.add(ident());
                if (eatP(Sym::Colon)) {
                    while (true) {
                        if (eatK(Sym::New)) {
                            expectP(Sym::LParen);
                            expectP(Sym::RParen);
                            p.add(node("new", ""));
                        } else {
                            p.add(typeName(false));
                        }
                        if (!eatP(Sym::Amp)) {
                            break;
                        }
                    }
                }
                ps.add(p);
                if (!eatP(Sym::Comma)) {
                    break;
                }
            }
            expectP(Sym::Gt);
        }
        return ps;
    }

    // ------------------------------------------------------------ Member

    Node classMember() mut {
        i32 l = line();
        i32 c = col();
        if (isK(Sym::Public) || isK(Sym::Private) || isK(Sym::Protected)) {
            string word = toks[pos].text;
            bump();
            expectP(Sym::Colon);
            return new Node("access", word, l, c);
        }
        if (eatK(Sym::Constructor)) {
            Node n = new Node("ctor", "", l, c);
            n.add(params());
            if (eatP(Sym::Colon)) {
                expectK(Sym::Base);
                Node b = node("baseargs", "");
                b.add(args());
                n.add(b);
            }
            n.add(block());
            return n;
        }
        if (eatK(Sym::Destructor)) {
            expectP(Sym::LParen);
            expectP(Sym::RParen);
            Node n = new Node("dtor", "", l, c);
            n.add(block());
            return n;
        }
        if (eatK(Sym::Copy)) {
            expectP(Sym::LParen);
            Node p = param();
            expectP(Sym::RParen);
            Node n = new Node("copy", "", l, c);
            n.add(p);
            n.add(block());
            return n;
        }
        if (eatK(Sym::Import)) {
            Node n = node("import", "");
            n.add(typeName(false));
            expectP(Sym::Semi);
            return n;
        }
        // fieldDecl, sonst methodDecl. Ohne den Versuch per Exception (M7-Nachtrag): wo fieldDecl
        // sicher scheitert, wird derselbe Fehlschlag festgehalten und gleich methodDecl gelesen.
        i64 save = pos;
        if (isK(Sym::Const) || (isK(Sym::Static) && isKAt(1, Sym::Const))) {
            try {
                return fieldDecl();
            } catch (ParseFail e) {
                pos = save;
            }
            return methodDecl(false);
        }
        if (isK(Sym::Static)) {
            // fieldDecl verlangt nach static const
            bump();
            noteFailure("'const'");
            pos = save;
            return methodDecl(false);
        }
        if (isK(Sym::Nodiscard) || isK(Sym::Abstract) || isK(Sym::Virtual) || isK(Sym::Override)
            || isK(Sym::Void) || isK(Sym::Ref)) {
            // kein Typ: fieldDecl scheitert hier
            noteFailure("type");
            return methodDecl(false);
        }
        // Feld und Methode beginnen beide mit Typ und Name; scheitert einer davon, dann in
        // beiden Alternativen an derselben Stelle mit derselben Meldung.
        Node t = ty(false);
        Node name = ident();
        if (isP(Sym::Assign) || isP(Sym::Semi)) {
            Node f = node("field", "");
            f.add(t);
            f.add(name);
            if (eatP(Sym::Assign)) {
                f.add(expression());
            }
            expectP(Sym::Semi);
            return f;
        }
        noteFailure("';'");
        pos = save;
        return methodDecl(false);
    }

    Node mixinMember() mut {
        if (eatK(Sym::Import)) {
            Node n = node("import", "");
            n.add(typeName(false));
            expectP(Sym::Semi);
            return n;
        }
        return methodDecl(true);
    }

    Node fieldDecl() mut {
        bool isStatic = false;
        bool isConst = false;
        if (eatK(Sym::Static)) {
            isStatic = true;
            expectK(Sym::Const);
            isConst = true;
        } else if (eatK(Sym::Const)) {
            isConst = true;
        }
        Node f = node("field", flag(flag("", isStatic, "static"), isConst, "const"));
        f.add(ty(false));
        f.add(ident());
        if (eatP(Sym::Assign)) {
            f.add(expression());
        }
        expectP(Sym::Semi);
        return f;
    }

    // methodDecl und abstractMethodDecl, im Mixin auch requirement
    Node methodDecl(bool inMixin) mut {
        bool nd = eatK(Sym::Nodiscard);
        string modifier = "";
        if (!inMixin && eatK(Sym::Abstract)) {
            modifier = "abstract";
        } else if (eatK(Sym::Static)) {
            modifier = "static";
        } else if (eatK(Sym::Virtual)) {
            modifier = "virtual";
        } else if (eatK(Sym::Override)) {
            modifier = "override";
        }
        Node ret = returnType();
        Node name = ident();
        Node tps = typeParamsOpt();
        Node ps = params();
        bool mutThis = eatK(Sym::Mut);
        bool without = modifier == "abstract" || (inMixin && modifier.length == 0);
        Node m = node("method", flag(flag(flag("", nd, "nodiscard"), modifier.length > 0, modifier), mutThis, "mut"));
        m.add(ret);
        m.add(name);
        m.add(tps);
        m.add(ps);
        bool noBody = without && eatP(Sym::Semi);
        if (!noBody) {
            if (modifier == "abstract") {
                throw failure("';'");
            }
            m.add(block());
        }
        return m;
    }

    Node params() mut {
        expectP(Sym::LParen);
        if (eatP(Sym::RParen)) {
            return node("params", "");
        }
        Node ps = paramList();
        expectP(Sym::RParen);
        return ps;
    }

    Node paramList() mut {
        Node ps = node("params", "");
        ps.add(param());
        while (eatP(Sym::Comma)) {
            ps.add(param());
        }
        return ps;
    }

    Node param() mut {
        bool mutable = eatK(Sym::Mut);
        Node t = ty(false);
        Node p = node("param", flag("", mutable, "mut"));
        p.add(t);
        p.add(ident());
        return p;
    }

    // ------------------------------------------------------------ Typen

    Node returnType() mut {
        if (eatK(Sym::Void)) {
            return node("void", "");
        }
        if (eatK(Sym::Ref)) {
            bool mutable = eatK(Sym::Mut);
            Node t = new Node("type", "", line(), col());
            t.add(baseType(false));
            typeSuffixes(mut t, false);
            Node r = node("refret", flag("", mutable, "mut"));
            r.add(t);
            return r;
        }
        return ty(false);
    }

    Node ty(bool afterAs) mut {
        Node t = new Node("type", "", line(), col());
        if (eatK(Sym::Own)) {
            t.text = "own";
        } else if (eatK(Sym::Shared)) {
            t.text = "shared";
        } else if (eatK(Sym::Weak)) {
            t.text = "weak";
        }
        t.add(baseType(afterAs));
        typeSuffixes(mut t, afterAs);
        return t;
    }

    Node baseType(bool afterAs) mut {
        if (isPrim(0)) {
            Node p = node("prim", toks[pos].text);
            bump();
            return p;
        }
        if (eatP(Sym::LParen)) {
            Node tu = node("tuple", "");
            tu.add(ty(false));
            expectP(Sym::Comma);
            tu.add(ty(false));
            while (eatP(Sym::Comma)) {
                tu.add(ty(false));
            }
            expectP(Sym::RParen);
            return tu;
        }
        if (isIdent(0)) {
            return typeName(afterAs);
        }
        throw failure("type");
    }

    Node typeName(bool afterAs) mut {
        Node n = node("typename", "");
        n.add(qualifiedName());
        if (!isP(Sym::Lt)) {
            n.add(node("targs", ""));
        } else if (afterAs) {
            i64 save = pos;
            try {
                n.add(typeArgs());
            } catch (ParseFail e) {
                pos = save;
                n.add(node("targs", ""));
            }
        } else {
            n.add(typeArgs());
        }
        return n;
    }

    Node typeArgs() mut {
        expectP(Sym::Lt);
        Node a = node("targs", "");
        while (true) {
            if (eatK(Sym::Void)) {
                a.add(node("void", ""));
            } else {
                bool mutable = eatK(Sym::Mut);
                Node t = ty(false);
                Node x = node("targ", flag("", mutable, "mut"));
                x.add(t);
                a.add(x);
            }
            if (!eatP(Sym::Comma)) {
                break;
            }
        }
        expectP(Sym::Gt);
        return a;
    }

    void typeSuffixes(mut Node t, bool afterAs) mut {
        while (true) {
            if (isP(Sym::Question)) {
                // Nach as gehört ? zum Bedingungsausdruck, wenn danach ein Ausdruck beginnt.
                if (afterAs && startsExpression(1)) {
                    break;
                }
                bump();
                t.add(node("nullable", ""));
            } else if (eatP(Sym::LBracket)) {
                if (eatP(Sym::RBracket)) {
                    t.add(node("vector", ""));
                    continue;
                }
                Node size = arraySize();
                expectP(Sym::RBracket);
                Node a = node("array", "");
                a.add(size);
                t.add(a);
            } else {
                break;
            }
        }
    }

    Node arraySize() mut {
        i64 i = pos;
        if (toks[i].kind == Kind::Int) {
            Node n = node("int", toks[i].text);
            bump();
            return n;
        }
        i64 save = pos;
        try {
            return staticRef();
        } catch (ParseFail e) {
            pos = save;
        }
        return ident();
    }

    // Kann an offset ein Ausdruck beginnen?
    bool startsExpression(i64 offset) {
        i64 i = idx(offset);
        ref Token t = toks[i];
        switch (t.kind) {
            case Ident: return true;
            case Int: return true;
            case Float: return true;
            case Str: return true;
            case Char: return true;
            case Keyword: {
                Sym w = t.sym;
                return w == Sym::This || w == Sym::Base || w == Sym::New || w == Sym::Cast || w == Sym::Copy
                    || w == Sym::True || w == Sym::False || w == Sym::Null || w == Sym::Own || primSyms[cast<i64>(w)];
            }
            case Punct: {
                Sym p = t.sym;
                return p == Sym::LParen || p == Sym::LBracket || p == Sym::Bang || p == Sym::Tilde || p == Sym::Minus
                    || p == Sym::PlusPlus || p == Sym::MinusMinus;
            }
            default: return false;
        }
    }

    // ------------------------------------------------------------ Anweisungen

    Node block() mut {
        Node b = new Node("block", "", line(), col());
        expectP(Sym::LBrace);
        while (!isP(Sym::RBrace)) {
            b.add(statement());
        }
        b.text = "end=" + line().toString() + ":" + col().toString();
        bump();
        return b;
    }

    Node statement() mut {
        i32 l = line();
        i32 c = col();
        if (isP(Sym::LBrace)) {
            return block();
        }
        if (eatK(Sym::If)) {
            Node n = new Node("if", "", l, c);
            n.add(parenExpr());
            n.add(statement());
            if (eatK(Sym::Else)) {
                n.add(statement());
            }
            return n;
        }
        if (eatK(Sym::While)) {
            Node n = new Node("while", "", l, c);
            n.add(parenExpr());
            n.add(statement());
            return n;
        }
        if (eatK(Sym::Do)) {
            Node n = new Node("dowhile", "", l, c);
            n.add(statement());
            expectK(Sym::While);
            n.add(parenExpr());
            expectP(Sym::Semi);
            return n;
        }
        if (isK(Sym::For)) {
            return forStmt(l, c);
        }
        if (isK(Sym::Switch)) {
            return switchStmt(l, c);
        }
        if (eatK(Sym::Return)) {
            Node n = new Node("return", "", l, c);
            if (eatP(Sym::Semi)) {
                return n;
            }
            if (eatK(Sym::Mut)) {
                n.text = "mut";
            }
            n.add(expression());
            expectP(Sym::Semi);
            return n;
        }
        if (eatK(Sym::Break)) {
            expectP(Sym::Semi);
            return new Node("break", "", l, c);
        }
        if (eatK(Sym::Continue)) {
            expectP(Sym::Semi);
            return new Node("continue", "", l, c);
        }
        if (eatK(Sym::Throw)) {
            Node n = new Node("throw", "", l, c);
            n.add(expression());
            expectP(Sym::Semi);
            return n;
        }
        if (isK(Sym::Try)) {
            return tryStmt(l, c);
        }
        if (eatK(Sym::Discard)) {
            Node n = new Node("discard", "", l, c);
            n.add(expression());
            expectP(Sym::Semi);
            return n;
        }
        if (isK(Sym::Ref)) {
            Node n = refDecl(l, c);
            expectP(Sym::Semi);
            return n;
        }
        // localVarDecl, tupleDecl und exprStatement: die erste Alternative, die die
        // ganze Anweisung liest, gewinnt.
        i64 save = pos;
        if (mayBeLocalDecl()) {
            try {
                Node d = localVarDecl(l, c);
                expectP(Sym::Semi);
                return d;
            } catch (ParseFail e) {
                pos = save;
            }
        }
        if (isP(Sym::LParen)) {
            try {
                Node d = tupleDecl(l, c);
                expectP(Sym::Semi);
                return d;
            } catch (ParseFail e) {
                pos = save;
            }
        }
        Node s = new Node("exprstmt", "", l, c);
        s.add(exprStatement());
        expectP(Sym::Semi);
        return s;
    }

    // Kann localVarDecl an pos gelingen? Wenn der Versuch sicher früh scheitert, wird der
    // Fehlschlag festgehalten, den er hinterließe, ohne ihn zu machen (M7-Nachtrag: sonst eine
    // Exception vor fast jeder Ausdrucksanweisung); dann false. true: der Versuch ist nötig.
    bool mayBeLocalDecl() mut {
        if (isIdent(0)) {
            // Typname: qualifizierter Name, dann Typargumente oder Suffixe, dann der Name
            i64 after = 1;
            while (isPAt(after, Sym::Dot) && isIdent(after + 1)) {
                after = after + 2;
            }
            if (isIdent(after) || isPAt(after, Sym::Lt) || isPAt(after, Sym::Question) || isPAt(after, Sym::LBracket)) {
                return true;
            }
            i64 save = pos;
            pos = save + after;
            noteFailure("name");
            pos = save;
            return false;
        }
        Sym w = toks[pos].sym;
        if (w == Sym::Const || w == Sym::Var || w == Sym::Own || w == Sym::Shared || w == Sym::Weak
            || w == Sym::LParen || primSyms[cast<i64>(w)]) {
            return true;
        }
        noteFailure("type");
        return false;
    }

    Node parenExpr() mut {
        expectP(Sym::LParen);
        Node e = expression();
        expectP(Sym::RParen);
        return e;
    }

    Node localVarDecl(i32 l, i32 c) mut {
        Node d = new Node("local", "", l, c);
        if (eatK(Sym::Const)) {
            d.text = "const";
        }
        if (eatK(Sym::Var)) {
            d.add(node("var", ""));
        } else {
            d.add(ty(false));
        }
        d.add(ident());
        if (eatP(Sym::Assign)) {
            d.add(expression());
        }
        return d;
    }

    Node refDecl(i32 l, i32 c) mut {
        expectK(Sym::Ref);
        bool mutable = eatK(Sym::Mut);
        Node t = new Node("type", "", line(), col());
        t.add(baseType(false));
        typeSuffixes(mut t, false);
        Node name = ident();
        expectP(Sym::Assign);
        if (mutable) {
            expectK(Sym::Mut);
        }
        Node r = new Node("ref", flag("", mutable, "mut"), l, c);
        r.add(t);
        r.add(name);
        r.add(expression());
        return r;
    }

    Node tupleDecl(i32 l, i32 c) mut {
        expectP(Sym::LParen);
        Node vars = node("vars", "");
        while (true) {
            Node v = node("tvar", "");
            v.add(ty(false));
            v.add(ident());
            vars.add(v);
            if (!eatP(Sym::Comma)) {
                break;
            }
        }
        if (vars.kids.length < 2) {
            throw failure("','");
        }
        expectP(Sym::RParen);
        expectP(Sym::Assign);
        Node d = new Node("tupledecl", "", l, c);
        d.add(vars);
        d.add(expression());
        return d;
    }

    string assignOp() {
        Sym p = toks[pos].sym;
        if (p == Sym::Assign || p == Sym::PlusEq || p == Sym::MinusEq || p == Sym::StarEq || p == Sym::SlashEq
            || p == Sym::PercentEq) {
            return toks[pos].text;
        }
        return "";
    }

    // exprStatement : unaryExpr assignOp expression | ('++'|'--') unaryExpr | postfixExpr
    Node exprStatement() mut {
        Node target = unary();
        string op = assignOp();
        if (op.length > 0) {
            bump();
            Node a = node("assign", op);
            a.add(target);
            a.add(expression());
            return a;
        }
        if (target.kind == "unary" && target.text != "++" && target.text != "--") {
            throw failure("assignment");
        }
        Node e = node("eval", "");
        e.add(target);
        return e;
    }

    // forEachStmt : FOR '(' MUT? (type | VAR) identifier ':' MUT? expression ')' statement
    Node? forEachHead(i32 l, i32 c) mut {
        i64 save = pos;
        try {
            Node f = new Node("foreach", "", l, c);
            if (eatK(Sym::Mut)) {
                f.text = "mut";
            }
            if (eatK(Sym::Var)) {
                f.add(node("var", ""));
            } else {
                f.add(ty(false));
            }
            f.add(ident());
            expectP(Sym::Colon);
            return f;
        } catch (ParseFail e) {
            pos = save;
            return null;
        }
    }

    Node forStmt(i32 l, i32 c) mut {
        expectK(Sym::For);
        expectP(Sym::LParen);
        Node? head = forEachHead(l, c);
        if (head != null) {
            bool mutable = head.text == "mut";
            bool borrow = eatK(Sym::Mut);
            head.text = flag(flag("", mutable, "mut"), borrow, "borrow");
            head.add(expression());
            expectP(Sym::RParen);
            head.add(statement());
            return head;
        }
        Node f = new Node("for", "", l, c);
        if (isP(Sym::Semi)) {
            f.add(node("noinit", ""));
        } else {
            f.add(forInit());
        }
        expectP(Sym::Semi);
        if (isP(Sym::Semi)) {
            f.add(node("nocond", ""));
        } else {
            f.add(expression());
        }
        expectP(Sym::Semi);
        if (isP(Sym::RParen)) {
            f.add(node("exprs", ""));
        } else {
            f.add(exprStatementList());
        }
        expectP(Sym::RParen);
        f.add(statement());
        return f;
    }

    Node forInit() mut {
        i64 save = pos;
        if (mayBeLocalDecl()) {
            try {
                Node d = localVarDecl(0, 0);
                if (!isP(Sym::Semi)) {
                    throw failure("';'");
                }
                return d;
            } catch (ParseFail e) {
                pos = save;
            }
        }
        if (!isP(Sym::LParen)) {
            // tupleDecl scheitert am ersten Token
            noteFailure("'('");
            return exprStatementList();
        }
        try {
            Node d = tupleDecl(0, 0);
            if (!isP(Sym::Semi)) {
                throw failure("';'");
            }
            return d;
        } catch (ParseFail e) {
            pos = save;
        }
        return exprStatementList();
    }

    Node exprStatementList() mut {
        Node list = node("exprs", "");
        list.add(exprStatement());
        while (eatP(Sym::Comma)) {
            list.add(exprStatement());
        }
        return list;
    }

    Node switchStmt(i32 l, i32 c) mut {
        expectK(Sym::Switch);
        Node s = new Node("switch", "", l, c);
        s.add(parenExpr());
        expectP(Sym::LBrace);
        while (!eatP(Sym::RBrace)) {
            Node cl = new Node("case", "", line(), col());
            Node pats = node("patterns", "");
            if (eatK(Sym::Default)) {
                cl.text = "default";
            } else {
                expectK(Sym::Case);
                pats.add(pattern());
                while (eatP(Sym::Comma)) {
                    pats.add(pattern());
                }
            }
            expectP(Sym::Colon);
            Node body = node("body", "");
            while (!(isK(Sym::Case) || isK(Sym::Default) || isP(Sym::RBrace))) {
                body.add(statement());
            }
            cl.add(pats);
            cl.add(body);
            s.add(cl);
        }
        return s;
    }

    Node? literalAt(i64 offset) {
        i64 i = idx(offset);
        ref Token t = toks[i];
        switch (t.kind) {
            case Int: return node("int", t.text);
            case Float: return node("float", t.text);
            case Str: return node("str", t.text);
            case Char: return node("char", t.text);
            case Keyword: {
                if (t.sym == Sym::True || t.sym == Sym::False) {
                    return node("bool", t.text);
                }
                if (t.sym == Sym::Null) {
                    return node("null", "");
                }
                return null;
            }
            default: return null;
        }
    }

    Node pattern() mut {
        bool negative = isP(Sym::Minus);
        i64 litAt = 0;
        if (negative) {
            litAt = 1;
        }
        Node? lit = literalAt(litAt);
        if (lit != null) {
            if (negative) {
                bump();
            }
            bump();
            Node p = node("plit", flag("", negative, "-"));
            p.add(lit);
            return p;
        }
        if (negative) {
            bump();
            throw failure("literal");
        }
        Node p = node("pname", "");
        i64 save = pos;
        try {
            p.add(staticRef());
        } catch (ParseFail e) {
            pos = save;
            p.add(ident());
        }
        if (eatP(Sym::LParen)) {
            Node bs = node("bindings", "");
            bs.add(ident());
            while (eatP(Sym::Comma)) {
                bs.add(ident());
            }
            expectP(Sym::RParen);
            p.add(bs);
        }
        return p;
    }

    Node tryStmt(i32 l, i32 c) mut {
        expectK(Sym::Try);
        Node t = new Node("try", "", l, c);
        t.add(block());
        i32 catches = 0;
        while (eatK(Sym::Catch)) {
            expectP(Sym::LParen);
            Node cl = node("catch", "");
            cl.add(ty(false));
            cl.add(ident());
            expectP(Sym::RParen);
            cl.add(block());
            t.add(cl);
            catches++;
        }
        if (eatK(Sym::Finally)) {
            Node f = node("finally", "");
            f.add(block());
            t.add(f);
        } else if (catches == 0) {
            throw failure("'catch' or 'finally'");
        }
        return t;
    }

    // ------------------------------------------------------------ Ausdrücke

    // expression : lambda | conditionalExpr
    Node expression() mut {
        if (isK(Sym::Own) || isP(Sym::LParen)) {
            Node? lambda = lambdaHead(line(), col());
            if (lambda != null) {
                if (isP(Sym::LBrace)) {
                    lambda.add(block());
                } else {
                    lambda.add(expression());
                }
                return lambda;
            }
        }
        return conditional();
    }

    // OWN? '(' paramList? ')' '=>'
    Node? lambdaHead(i32 l, i32 c) mut {
        i64 save = pos;
        try {
            bool isOwn = eatK(Sym::Own);
            Node ps = params();
            expectP(Sym::Arrow);
            Node n = new Node("lambda", flag("", isOwn, "own"), l, c);
            n.add(ps);
            return n;
        } catch (ParseFail e) {
            pos = save;
            return null;
        }
    }

    Node conditional() mut {
        Node c = coalesce();
        if (isP(Sym::Question)) {
            Node n = new Node("cond", "", c.line, c.col);
            bump();
            n.add(c);
            n.add(expression());
            expectP(Sym::Colon);
            n.add(expression());
            return n;
        }
        return c;
    }

    Node coalesce() mut {
        Node left = binary(0);
        if (eatP(Sym::Coalesce)) {
            Node n = new Node("coalesce", "", left.line, left.col);
            n.add(left);
            n.add(coalesce());
            return n;
        }
        return left;
    }

    // Nächster zweistelliger Operator: (Operator, Anzahl Tokens, Vorrang × 2); "" wenn keiner.
    // as hat Stufe 10a, also 21.
    (string, i64, i32) binaryOp() {
        if (isK(Sym::As)) {
            return ("as", 1, 21);
        }
        if (isP(Sym::Lt) && isPAt(1, Sym::Lt)) {
            return ("<<", 2, 22);
        }
        if (isP(Sym::Gt) && isPAt(1, Sym::Gt)) {
            return (">>", 2, 22);
        }
        Sym p = toks[pos].sym;
        i32 prec = 0;
        if (p == Sym::Star || p == Sym::Slash || p == Sym::Percent) {
            prec = 26;
        } else if (p == Sym::Plus || p == Sym::Minus) {
            prec = 24;
        } else if (p == Sym::Lt || p == Sym::Gt || p == Sym::LtEq || p == Sym::GtEq) {
            prec = 20;
        } else if (p == Sym::EqEq || p == Sym::NotEq) {
            prec = 18;
        } else if (p == Sym::Amp) {
            prec = 16;
        } else if (p == Sym::Caret) {
            prec = 14;
        } else if (p == Sym::Pipe) {
            prec = 12;
        } else if (p == Sym::AndAnd) {
            prec = 10;
        } else if (p == Sym::OrOr) {
            prec = 8;
        } else {
            return ("", 0, 0);
        }
        return (toks[pos].text, 1, prec);
    }

    Node binary(i32 minPrec) mut {
        Node left = unary();
        while (true) {
            (string op, i64 width, i32 prec) = binaryOp();
            if (op.length == 0 || prec < minPrec) {
                break;
            }
            i32 l = left.line;
            i32 c = left.col;
            for (i64 i = 0; i < width; i++) {
                bump();
            }
            if (op == "as") {
                Node n = new Node("as", "", l, c);
                n.add(left);
                n.add(ty(true));
                left = n;
            } else {
                Node n = new Node("binary", op, l, c);
                n.add(left);
                n.add(binary(prec + 1));
                left = n;
            }
        }
        return left;
    }

    Node unary() mut {
        i32 l = line();
        i32 c = col();
        string op = "";
        if (isP(Sym::Bang) || isP(Sym::Tilde) || isP(Sym::Minus) || isP(Sym::PlusPlus) || isP(Sym::MinusMinus)) {
            op = toks[pos].text;
        } else {
            return postfix();
        }
        bump();
        Node n = new Node("unary", op, l, c);
        n.add(unary());
        return n;
    }

    Node postfix() mut {
        Node e = primary();
        while (true) {
            i32 l = e.line;
            i32 c = e.col;
            if (isP(Sym::Dot) || isP(Sym::SafeDot)) {
                bool safe = isP(Sym::SafeDot);
                bump();
                Node n = new Node("member", flag("", safe, "safe"), l, c);
                n.add(e);
                n.add(ident());
                e = n;
            } else if (isP(Sym::LParen)) {
                Node n = new Node("call", "", l, c);
                n.add(e);
                n.add(args());
                e = n;
            } else if (eatP(Sym::LBracket)) {
                Node? from = null;
                if (!isP(Sym::DotDot)) {
                    from = expression();
                }
                if (eatP(Sym::DotDot)) {
                    Node? to = null;
                    if (!isP(Sym::RBracket)) {
                        to = expression();
                    }
                    expectP(Sym::RBracket);
                    Node n = new Node("slice", "", l, c);
                    n.add(e);
                    n.add(from ?? node("none", ""));
                    n.add(to ?? node("none", ""));
                    e = n;
                } else {
                    expectP(Sym::RBracket);
                    Node n = new Node("index", "", l, c);
                    n.add(e);
                    n.add(from ?? node("none", ""));
                    e = n;
                }
            } else if (eatP(Sym::PlusPlus)) {
                Node n = new Node("postinc", "", l, c);
                n.add(e);
                e = n;
            } else if (eatP(Sym::MinusMinus)) {
                Node n = new Node("postdec", "", l, c);
                n.add(e);
                e = n;
            } else {
                return e;
            }
        }
    }

    Node args() mut {
        expectP(Sym::LParen);
        Node a = node("args", "");
        if (eatP(Sym::RParen)) {
            return a;
        }
        while (true) {
            bool mutable = eatK(Sym::Mut);
            Node x = node("arg", flag("", mutable, "mut"));
            x.add(expression());
            a.add(x);
            if (!eatP(Sym::Comma)) {
                break;
            }
        }
        expectP(Sym::RParen);
        return a;
    }

    // staticRef : (qualifiedName typeArgs? | primitiveType) '::' identifier
    Node staticRef() mut {
        Node s = new Node("sref", "", line(), col());
        if (isPrim(0)) {
            s.add(node("prim", toks[pos].text));
            bump();
        } else {
            Node owner = node("typename", "");
            owner.add(qualifiedName());
            if (isP(Sym::Lt)) {
                i64 save = pos;
                try {
                    owner.add(typeArgs());
                } catch (ParseFail e) {
                    pos = save;
                    owner.add(node("targs", ""));
                }
            } else {
                owner.add(node("targs", ""));
            }
            s.add(owner);
        }
        expectP(Sym::ColonColon);
        s.add(ident());
        return s;
    }

    Node primary() mut {
        i32 l = line();
        i32 c = col();
        Node? lit = literalAt(0);
        if (lit != null) {
            lit.line = l;
            lit.col = c;
            bump();
            return lit;
        }
        if (eatK(Sym::This)) {
            return new Node("this", "", l, c);
        }
        if (eatK(Sym::Base)) {
            return new Node("base", "", l, c);
        }
        if (eatP(Sym::LParen)) {
            Node first = expression();
            if (eatP(Sym::Comma)) {
                Node t = new Node("tuple", "", l, c);
                t.add(first);
                t.add(expression());
                while (eatP(Sym::Comma)) {
                    t.add(expression());
                }
                expectP(Sym::RParen);
                return t;
            }
            expectP(Sym::RParen);
            Node p = new Node("paren", "", l, c);
            p.add(first);
            return p;
        }
        if (eatP(Sym::LBracket)) {
            Node a = new Node("array", "", l, c);
            if (!eatP(Sym::RBracket)) {
                a.add(expression());
                while (eatP(Sym::Comma)) {
                    a.add(expression());
                }
                expectP(Sym::RBracket);
            }
            return a;
        }
        if (eatK(Sym::New)) {
            Node n = new Node("new", "", l, c);
            n.add(typeName(false));
            n.add(args());
            return n;
        }
        if (eatK(Sym::Cast)) {
            expectP(Sym::Lt);
            Node t = ty(false);
            expectP(Sym::Gt);
            Node n = new Node("cast", "", l, c);
            n.add(t);
            n.add(parenExpr());
            return n;
        }
        if (eatK(Sym::Copy)) {
            Node n = new Node("copy", "", l, c);
            n.add(parenExpr());
            return n;
        }
        if (isIdent(0)) {
            i64 save = pos;
            // staticRef liest einen qualifizierten Namen und verlangt danach '::' (nach '<'
            // erst Typargumente). Steht dort keins von beiden, scheitert der Versuch genau an
            // dieser Stelle mit "Expected '::'"; das wird festgehalten, ohne den Versuch zu
            // machen (M7: sonst eine Exception für fast jeden Namen in einem Ausdruck).
            i64 after = 1;
            while (isPAt(after, Sym::Dot) && isIdent(after + 1)) {
                after = after + 2;
            }
            if (isPAt(after, Sym::ColonColon) || isPAt(after, Sym::Lt)) {
                try {
                    Node s = new Node("static", "", l, c);
                    s.add(staticRef());
                    return s;
                } catch (ParseFail e) {
                    pos = save;
                }
            } else {
                pos = save + after;
                noteFailure("'::'");
                pos = save;
            }
            Node id = ident();
            return new Node("name", id.text, l, c);
        }
        if (isPrim(0)) {
            Node s = new Node("static", "", l, c);
            s.add(staticRef());
            return s;
        }
        throw failure("expression");
    }

public:
    constructor(own Token[] toks) {
        this.toks = toks;
        for (i64 i = 0; i < symTexts.length; i++) {
            primSyms.push(false);
        }
        Sym[] words = [Sym::Bool, Sym::Char, Sym::Byte, Sym::String, Sym::I8, Sym::I16, Sym::I32, Sym::I64,
            Sym::Ui8, Sym::Ui16, Sym::Ui32, Sym::Ui64, Sym::F32, Sym::F64];
        for (Sym w : words) {
            primSyms[cast<i64>(w)] = true;
        }
    }

    // compilationUnit; wirft ParseFail, die Meldung liefert errorText()
    Node compilationUnit() mut {
        Node unit = node("unit", "");
        if (eatK(Sym::Package)) {
            Node p = node("package", "");
            p.add(qualifiedName());
            expectP(Sym::Semi);
            unit.add(p);
        }
        while (isK(Sym::Using)) {
            Node u = new Node("using", "", line(), col());
            bump();
            if (isIdent(0) && isPAt(1, Sym::Assign)) {
                u.text = "alias";
                u.add(ident());
                bump();
            }
            u.add(qualifiedName());
            expectP(Sym::Semi);
            unit.add(u);
        }
        while (!atEof()) {
            if (isK(Sym::I32)) {
                unit.add(mainDecl());
            } else {
                unit.add(typeDecl());
            }
        }
        return unit;
    }

    // Position und Meldung des Fehlers nach einer ParseFail (wie Parser::error in rppc)
    (i32, i32, string) error() {
        i64 p = pos;
        string msg = "Syntax error";
        if (farPos >= 0) {
            p = farPos;
            string found = "found " + shownAt(farPos);
            if (toks[farPos].kind == Kind::Error) {
                found = toks[farPos].text;
            }
            msg = "Expected " + farExpected + ", " + found;
        }
        if (p > toks.length - 1) {
            p = toks.length - 1;
        }
        return (toks[p].line, toks[p].col, msg);
    }

    // Wie Display von SyntaxError: "Line l:c message"
    string errorText() {
        (i32 l, i32 c, string msg) = error();
        return "Line " + l.toString() + ":" + c.toString() + " " + msg;
    }

    static string badStatement() {
        return "Expression cannot be used as a statement (only assignments, calls, ++ and -- are allowed)";
    }

    // Erlaubte Formen von Ausdrucksanweisungen (Kapitel 8, R-8.12): der erste Verstoß
    // als "Line l:c message", sonst "".
    static string check(Node unit) {
        (i32 l, i32 c) = firstBad(unit, 0, 0);
        if (l == 0) {
            return "";
        }
        return "Line " + l.toString() + ":" + c.toString() + " " + badStatement();
    }

    static (i32, i32) firstBad(Node n, i32 sl, i32 sc) {
        i64 key = firstBadKey(n, cast<i64>(sl) * 4294967296 + cast<i64>(sc));
        return (cast<i32>(key / 4294967296), cast<i32>(key % 4294967296));
    }

private:
    // Wie firstBad, mit der Position als zeile * 2^32 + spalte (0: kein Verstoß); so entsteht
    // nicht für jeden Knoten ein Tupel. start ist die Position der umgebenden Anweisung.
    static i64 firstBadKey(Node n, i64 start) {
        i64 at = start;
        if (n.kind == "exprstmt" || n.kind == "for") {
            at = cast<i64>(n.line) * 4294967296 + cast<i64>(n.col);
        }
        i64 bad = 0;
        if (n.kind == "eval") {
            ref Node e = n.kids[0];
            bool ok = e.kind == "call" || e.kind == "postinc" || e.kind == "postdec"
                || (e.kind == "unary" && (e.text == "++" || e.text == "--"));
            if (!ok) {
                bad = at;
            }
        }
        for (Node k : n.kids) {
            i64 kb = firstBadKey(k, at);
            // Zeilen beginnen bei 1: kb > 0 heißt, es gibt einen Verstoß
            if (kb >= 4294967296 && (bad < 4294967296 || kb < bad)) {
                bad = kb;
            }
        }
        return bad;
    }
}
