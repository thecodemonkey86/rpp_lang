package konformitaet.kap06;

class Node {
public:
    string name;
    Node? child;
    shared Node? next;
    weak Node? parent;
    i32? count;
    Node?[] slots = [];
    constructor(string n) { this.name = n; }
    bool ok() { return true; }
    void run() { }
    void touch() & { }
}

class T {
public:
    string m(Node? x, i32? a) {
        x?.run();
        bool? ok = x?.ok();
        string name = x?.name ?? "-";
        i32 n = (a ?? 0) + 1;
        i32 k = a ?? 0;
        string chain = x?.child?.name ?? "kein Kind";
        return x?.name ?? x?.child?.name ?? "nichts";
    }
}
