// Konformitätstest Kapitel 6 – muss übersetzt werden.
// Regel: R-6.1, R-6.2, R-6.3, R-6.4, R-6.6, R-6.7, R-6.8, R-6.9, R-6.10, R-6.11
package konformitaet.kap06;

class Node {
public:
    string name;
    Node? child;
    shared Node? next;
    weak Node? parent;
    i32? count;
    Node?[] slots = [];
    constructor(string n) { this.name = n; }
    bool ok() { return true; }
    void run() { }
    void touch() & { }
}

class T {
public:
    void ifBlock(Node? x) {
        if (x != null) {
            x.run();
        }
    }

    void elseZweig(Node? x) {
        if (x == null) {
            print("leer");
        } else {
            x.run();
        }
    }

    void frueherAusstieg(Node? x, Node? y) {
        if (x == null) {
            return;
        }
        x.run();
        if (y == null) {
            throw new Exception("y fehlt");
        }
        y.run();
    }

    void ausdruecke(Node? x, Node? y) {
        bool b = x != null && x.ok();
        bool c = x == null || x.ok();
        bool d = !(x == null) && x.ok();
        string s = x != null ? x.name : "-";
        if (x != null && y != null) {
            x.run();
            y.run();
        }
        if (x == null || y == null) {
            return;
        }
        x.run();
        y.run();
    }

    void schleifen(Node? start, Node?[] list) {
        Node? cur = null;
        while (cur != null) {
            cur.run();
            cur = null;
        }
        for (Node? e : list) {
            if (e == null) {
                continue;
            }
            e.run();
        }
    }

    void assertVerengt(Node? x) {
        assert(x != null, "x fehlt");
        x.run();
    }

    void zuweisung(Node? x) {
        Node? y = null;
        y = new Node("neu");
        y.run();
    }
}
