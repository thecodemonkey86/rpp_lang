// Konformitätstest Kapitel 6 – muss abgelehnt werden.
// Regel: R-6.9
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (am Schleifenkopf ist cur nicht mehr sicher verengt).
package konformitaet.kap06;

class Node {
public:
    string name;
    Node? child;
    shared Node? next;
    weak Node? parent;
    i32? count;
    Node?[] slots;
    constructor(string n) { this.name = n; }
    bool ok() { return true; }
    void run() { }
    void touch() & { }
}

class T {
public:
    void m(Node? x, Node? y, i32? a, bool flag) {
        shared Node? cur = new Node("a");
        if (cur == null) {
            return;
        }
        while (flag) {
            cur.run(); // FEHLER
            cur = null;
        }
    }
}
