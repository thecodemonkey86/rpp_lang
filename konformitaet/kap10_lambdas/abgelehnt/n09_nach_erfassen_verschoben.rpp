// Konformitätstest Kapitel 10 – muss abgelehnt werden.
// Regel: R-10.8, Kapitel 5 R-5.3
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (owned wurde ins Lambda verschoben).
package konformitaet.kap10;

class Foo {
public:
    i32 x = 0;
    void bump() mut { x++; }
    copy(Foo other) { this.x = other.x; }
}

class Counter {
public:
    i32 n = 0;
    void increment() mut { n++; }
}

class Items {
public:
    Foo[] list = [];
    void forEach(Func<Foo, void> f) {
        for (Foo e : list) { f(e); }
    }
    void update(Func<mut Foo, void> f) mut {
        for (mut Foo e : mut list) { f(mut e); }
    }
    i32 sum(Func<Foo, i32> f) {
        i32 s = 0;
        for (Foo e : list) { s += f(e); }
        return s;
    }
}

class T {
public:
    void m() {
        Foo owned = new Foo();
        Func<i32> get = own () => owned.x;
        owned.bump(); // FEHLER
    }
}
