// Konformitätstest Kapitel 10 – Laufzeit.
// Regel: R-10.2, R-10.6, R-10.7, R-10.8
// Erwartet: Ausgabe "6\n11\n16"; Exit-Code 0
class Util {
public:
    static void each(i32[] xs, Func<i32, void> f) {
        for (i32 x : xs) {
            f(x);
        }
    }
}

i32 main(string[] args) {
    i32 sum = 0;
    i32[] xs = [1, 2, 3];
    Util::each(xs, (i32 x) => { sum += x; });
    print(sum.toString());
    i32 start = 10;
    Func<i32, i32> add = own (i32 x) => x + start;
    start = 20;
    print(add(1).toString());
    print(((i32 v) => v * v)(4).toString());
    return 0;
}
