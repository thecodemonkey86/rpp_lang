// Konformitätstest Kapitel 10 – muss übersetzt werden.
// Regel: R-10.6, R-10.7, R-10.8, R-10.11
package konformitaet.kap10;

class Foo {
public:
    i32 x = 0;
    void bump() mut { x++; }
    copy(Foo other) { this.x = other.x; }
}

class Counter {
public:
    i32 n = 0;
    void increment() mut { n++; }
}

class Items {
public:
    Foo[] list = [];
    void forEach(Func<Foo, void> f) {
        for (Foo e : list) { f(e); }
    }
    void update(Func<mut Foo, void> f) mut {
        for (mut Foo e : mut list) { f(mut e); }
    }
    i32 sum(Func<Foo, i32> f) {
        i32 s = 0;
        for (Foo e : list) { s += f(e); }
        return s;
    }
}

class Capture {
public:
    void demo(mut Items items, shared Counter c, Foo borrowed) {
        i32 limit = 10;
        i32 sum = 0;
        items.forEach((Foo f) => {
            if (f.x < limit) {
                sum += f.x;
            }
        });
        items.update((mut Foo f) => f.bump());
        Foo owned = new Foo();
        Func<i32> get = own () => owned.x;
        Func<void> inc = own () => c.increment();
        inc();
        Foo kopie = copy(borrowed);
        Func<i32> fromCopy = own () => kopie.x;
        string text = "abc";
        Func<i64> len = own () => text.length;
    }
}
