// Konformitätstest Kapitel 10 – muss übersetzt werden.
// Regel: R-10.1, R-10.2, R-10.3, R-10.4, R-10.5, R-10.8, R-10.13, R-10.17
package konformitaet.kap10;

class Foo {
public:
    i32 x = 0;
    void bump() mut { x++; }
    copy(Foo other) { this.x = other.x; }
}

class Counter {
public:
    i32 n = 0;
    void increment() mut { n++; }
}

class Items {
public:
    Foo[] list = [];
    void forEach(Func<Foo, void> f) {
        for (Foo e : list) { f(e); }
    }
    void update(Func<mut Foo, void> f) mut {
        for (mut Foo e : mut list) { f(mut e); }
    }
    i32 sum(Func<Foo, i32> f) {
        i32 s = 0;
        for (Foo e : list) { s += f(e); }
        return s;
    }
}

class Basics {
public:
    void demo(mut Items items) {
        var square = own (i32 x) => x * x;
        i32 a = square(4);
        Func<i32, i64> widen = own (i32 x) => x;
        i64 b = widen(3);
        Func<i32, string> name = own (i32 x) => {
            if (x > 0) {
                return "positiv";
            }
            return "sonst";
        };
        string n = name(1);
        i32 total = items.sum((Foo f) => f.x * 2);
        i32 direct = ((i32 v) => v + 1)(3);
        Func<void> hello = own () => print("hallo");
        hello();
    }
}
