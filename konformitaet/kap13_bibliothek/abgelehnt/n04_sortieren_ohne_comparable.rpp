// Konformitätstest Kapitel 13 – muss abgelehnt werden.
// Regel: R-13.16
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Symbol ist nicht Comparable).
package konformitaet.kap13;
using rpp.collections.Map;
using rpp.collections.Entry;

class Symbol {
public:
    string name;
    i32 uses = 0;
    constructor(string n) { this.name = n; }
    void use() mut { uses++; }
}

class T {
public:
    void m(mut Symbol[] list) {
        list.sort(); // FEHLER
    }
}
