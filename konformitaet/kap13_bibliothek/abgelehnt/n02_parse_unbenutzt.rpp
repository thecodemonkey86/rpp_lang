// Regel: R-8.13
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (das Ergebnis von parse wird nicht verwendet).
package konformitaet.kap13;
using rpp.collections.Map;
using rpp.collections.Entry;

class Symbol {
public:
    string name;
    i32 uses = 0;
    constructor(string n) { this.name = n; }
    void use() mut { uses++; }
}

class T {
public:
    void m(string s) {
        i32::parse(s); // FEHLER
    }
}
