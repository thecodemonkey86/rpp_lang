// Konformitätstest Kapitel 13 – Laufzeit.
// Regel: R-13.42
// Erwartet: Ausgabe "2\n4\n6\n8\n10\n3\n4\n5\n1\n2\n3\na\na!\nb\nb!\n1\n2\n3\n4"; Exit-Code 0
using rpp.iter.Iter;

i32 main(string[] args) {
    // Lazy map: jedes Element wird verdoppelt.
    for (i32 x : Iter::map([1, 2, 3, 4, 5], (i32 v) => v * 2)) { print(x.toString()); }

    // Lazy filter: Elemente großer 2.
    for (i32 x : Iter::filter([1, 2, 3, 4, 5], (i32 v) => v > 2)) { print(x.toString()); }

    // Lazy take: höchstens drei Elemente.
    for (i32 x : Iter::take([1, 2, 3, 4, 5], 3)) { print(x.toString()); }

    // Lazy flatMap: jedes Element wird zu einer Wortliste.
    for (string w : Iter::flatMap(["a", "b"], (string s) => { shared string[] r = []; r.push(s); r.push(s + "!"); return r; })) { print(w); }

    // Lazy chain: Quelle gefolgt von einer zweiten Quelle.
    for (i32 x : Iter::chain([1, 2], [3, 4])) { print(x.toString()); }

    return 0;
}
