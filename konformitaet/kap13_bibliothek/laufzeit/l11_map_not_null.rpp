// Konformitätstest Kapitel 13 – Laufzeit.
// Regel: R-13.9, R-13.10
// Erwartet: Ausgabe "0\n1\n0\n3\n4\n5\n4\n0\n4\n0"; Exit-Code 0
using rpp.collections.Set;

class Box {
public:
    i32 value;
    constructor(i32 value) { this.value = value; }
}

i32 main(string[] args) {
    Set<i32> numbers = new Set<i32>();
    Func<i32, Box?> boxEven = own (i32 n) => {
        print(n.toString());
        return n % 2 == 0 ? new Box(n) : null;
    };
    Box[] empty = numbers.mapNotNull(boxEven);
    print(empty.length.toString());
    numbers.add(1);
    Box[] skipped = numbers.mapNotNull(boxEven);
    print(skipped.length.toString());
    numbers.clear();
    numbers.add(3);
    numbers.add(4);
    numbers.add(5);
    Box[] boxes = numbers.mapNotNull(boxEven);
    print(boxes[0].value.toString());

    Func<i32, i32?> evenOrZero = own (i32 n) => n % 2 == 0 ? n : 0;
    i32[] values = numbers.mapNotNull(evenOrZero);
    for (i32 n : values) { print(n.toString()); }
    return 0;
}
