// Konformitätstest Kapitel 13 – Laufzeit.
// Regel: R-13.43, R-13.44
// Erwartet: Ausgabe "out|err|3\nb,a\nsub\n5000\n5\ntrue\nIOException\nIOException"; Exit-Code 0
using rpp.process.Process;
using rpp.process.ProcessResult;
using rpp.env.Env;
using rpp.env.Os;
using rpp.io.Dir;
using rpp.io.File;
using rpp.io.Path;
using rpp.text.Text;

class Shell {
public:
    // Kommandozeile der Plattform-Shell (cmd unter Windows, sonst sh)
    static own ProcessResult run(string windows, string posix, string input, string? workDir) {
        if (Env::os() == Os::Windows) {
            return Process::run("cmd", ["/d", "/c", windows], input, workDir);
        }
        return Process::run("sh", ["-c", posix], input, workDir);
    }

    // erbt die Standardströme, liefert nur den Exit-Code
    static i32 call(string windows, string posix) {
        if (Env::os() == Os::Windows) {
            return Process::call("cmd", ["/d", "/c", windows], null);
        }
        return Process::call("sh", ["-c", posix], null);
    }

    static string clean(string s) {
        return s.replace("\r", "").trim();
    }
}

i32 main(string[] args) {
    // Ausgabe, Fehlerausgabe und Exit-Code getrennt
    ProcessResult r = Shell::run("echo out& echo err 1>&2& exit 3", "echo out; echo err >&2; exit 3", "", null);
    print(Shell::clean(r.output) + "|" + Shell::clean(r.errorOutput) + "|" + r.exitCode.toString());

    // Eingabe über die Standardeingabe
    ProcessResult e = Shell::run("findstr .", "cat", "b\na\n", null);
    print(string::join(",", Text::lines(Shell::clean(e.output))));

    // Arbeitsverzeichnis
    Dir::create("sub");
    ProcessResult w = Shell::run("cd", "pwd", "", "sub");
    print(Path::fileName(Shell::clean(w.output)));

    // große Ausgabe und Eingabe ohne Verklemmung
    string big = Text::repeat("0123456789abcdef\n", 5000);
    ProcessResult b = Shell::run("findstr .", "cat", big, null);
    print(Text::lines(Shell::clean(b.output)).length.toString());

    // geerbte Standardströme
    print(Shell::call("exit 5", "exit 5").toString());

    // Pfad des laufenden Programms (R-13.44)
    string self = Env::executablePath();
    print((File::exists(self) && Path::absolute(self) == self).toString());

    // Fehler beim Start: unbekanntes Programm, fehlendes Arbeitsverzeichnis
    try {
        discard Process::run("rpp-gibt-es-nicht-4711", [], "", null);
    } catch (IOException x) {
        print("IOException");
    }
    try {
        discard Shell::run("cd", "pwd", "", "fehlt");
    } catch (IOException x) {
        print("IOException");
    }
    return 0;
}
