class Named {
public:
    string n;
    constructor(string n) { this.n = n; }
    destructor() { print(n); }
}

i32 main(string[] args) {
    Named a = new Named("a");
    Named b = new Named("b");
    Named c = new Named("c");
    return 0;
}
