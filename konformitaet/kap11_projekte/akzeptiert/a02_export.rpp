// Konformitätstest Kapitel 11 – muss übersetzt werden.
// Regel: R-11.10, R-11.11
package konformitaet.kap11;

export class Shape {
public:
    f64 area() { return 0.0; }
    Point center() { return new Point(); }
private:
    Helper helper = new Helper();
}

export class Point {
public:
    f64 x = 0.0;
}

class Helper {
public:
    i32 n = 0;
}
