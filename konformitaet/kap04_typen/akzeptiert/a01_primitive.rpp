package konformitaet.kap04;

class T {
public:
    void m(i32 n, i64 big, ui32 u, ui64 uu, f32 f, f64 d, byte b, char c, string s) {
        bool ok = n > 0 && !(d < 0.0);
        if (ok) { print("ja"); }
        bool same = c == 'a';
        ui32 code = cast<ui32>(c);
        char back = cast<char>(code);
        byte mask = b & cast<byte>(cast<ui8>(15));
        byte inv = ~b;
        ui8 raw = cast<ui8>(b);
        bool less = b < mask;
    }
