package konformitaet.kap04;

class Node {
public:
    Node? next;
    i32 value;
    constructor(i32 v) { this.value = v; }

    i32 demo(bool flag) {
        i32? maybe = null;
        i32 x;
        if (flag) {
            x = 1;
        } else {
            x = 2;
        }
        Node? n = null;
        shared Node? s = null;
        i32 y = maybe ?? x;
        return y;
    }
}
