// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (< ist für T ohne Comparable nicht zugesagt).
package konformitaet.kap04;

class Util {
public:
    static bool less<T>(T a, T b) {
        return a < b; // FEHLER
    }
}
