// Konformitätstest Kapitel 7 – Laufzeit.
// Regel: R-7.13, R-7.22
// Erwartet: Ausgabe "Base:A\nB\nBase:A"; Exit-Code 0
class Base {
public:
    virtual string name() { return "Base"; }
}

class A : Base {
public:
    override string name() { return base.name() + ":A"; }
}

class B : Base {
public:
    override string name() { return "B"; }
}

class Caller {
public:
    static string name(Base value) { return value.name(); }
}

i32 main(string[] args) {
    A a = new A();
    B b = new B();
    print(Caller::name(a));
    print(Caller::name(b));
    print(Caller::name(a));
    return 0;
}
