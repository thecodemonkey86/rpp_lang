// Konformitätstest Kapitel 7 – muss abgelehnt werden.
// Regel: R-7.7
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (name ist am Ende des Konstruktors nicht auf jedem Weg gesetzt).
package konformitaet.kap07;

class Person {
public:
    string name;
    constructor(bool flag) {
        if (flag) {
            this.name = "a";
        }
    } // FEHLER
}
