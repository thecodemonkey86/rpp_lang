// Konformitätstest Kapitel 7 – muss abgelehnt werden.
// Regel: R-7.20
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (die Anforderung name() ist nicht erfüllt).
package konformitaet.kap07;

mixin Named {
    string name();
    string greet() { return "Hallo " + name(); }
}

class Person {
    import Named; // FEHLER
public:
    string n = "";
}
