// Konformitätstest Kapitel 7 – muss abgelehnt werden.
// Regel: R-7.9
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (ein Destruktor wird nie direkt aufgerufen).
package konformitaet.kap07;

class Foo {
public:
    destructor() { print("weg"); }
}

class T {
public:
    void m(Foo& f) {
        f.destructor(); // FEHLER
    }
}
