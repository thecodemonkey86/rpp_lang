// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.17 (T-Borrow), Satz 5.2
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (v ist durch den Slice s geliehen).
package konformitaet.kap05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void m() {
        i32[] v = [1, 2, 3];
        Slice<i32> s = v[0..2];
        v.push(4); // FEHLER
        i32 x = s[0];
    }
}
