// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: R-5.25, V-15
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (Guard hat einen Destruktor; Zerlegen würde ihn übergehen).
package konformitaet.kap05;

class Guard {
public:
    i32 a = 0;
    i32 b = 0;
    destructor() { print("aufräumen"); }
}

class T {
public:
    void m() {
        Guard g = new Guard();
        (i32 a, i32 b) = g; // FEHLER
    }
}
