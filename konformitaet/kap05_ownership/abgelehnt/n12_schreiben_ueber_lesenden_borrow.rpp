// Konformitätstest Kapitel 5 – muss abgelehnt werden.
// Regel: Schreibrecht (3.2), R-5.10
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (a ist nur lesend geliehen).
package konformitaet.kap05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class T {
public:
    void m(Foo a) {
        a.bump(); // FEHLER
    }
}
