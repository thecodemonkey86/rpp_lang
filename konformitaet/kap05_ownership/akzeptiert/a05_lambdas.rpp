// Konformitätstest Kapitel 5 – muss übersetzt werden.
// Regel: Kapitel 5 Abschnitt 7, R-10.7, R-10.8
package konformitaet.kap05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class Lambdas {
public:
    void each(i32[] xs, Func<i32, void> f) {
        for (i32 x : xs) { f(x); }
    }

    // own-Lambda: start wird in das Lambda verschoben.
    Func<i32, i32> adder(own Foo start) {
        return own (i32 x) => x + start.value;
    }

    void demo() {
        i32 sum = 0;
        i32[] xs = [1, 2, 3];
        // sum ist für die Dauer des Aufrufs veränderbar geliehen.
        each(xs, (i32 x) => { sum += x; });
        Foo f = new Foo(10);
        Func<i32, i32> g = adder(f);
        i32 r = g(1);
    }
}
