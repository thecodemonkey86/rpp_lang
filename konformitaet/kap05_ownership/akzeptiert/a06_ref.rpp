// Konformitätstest Kapitel 5 – muss übersetzt werden.
// Regel: ref-Deklaration (Abschnitt 7), R-5.17
package konformitaet.kap05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() mut { this.value = this.value + 1; }
}

class Holder {
public:
    Foo payload;
    Foo? spare;
    constructor(own Foo p) { this.payload = p; this.spare = null; }
}

class RefDemo {
public:
    void demo(mut Holder h) {
        Foo[] list = [new Foo(1), new Foo(2)];
        // Lesender Borrow bis Blockende; zwei lesende Borrows dürfen nebeneinander bestehen.
        {
            ref Foo first = list[0];
            ref Foo again = list[0];
            print("x");
            first.run();
            again.run();
        }
        // Nach dem Block ist list wieder frei.
        list.push(new Foo(3));
        // Veränderbarer Borrow auf ein Feld; ein anderes Feld bleibt zugänglich.
        ref mut Foo p = mut h.payload;
        p.bump();
        ref Foo? s = h.spare;
        if (s != null) {
            s.run();
        }
    }
}
