// Konformitätstest Kapitel 5 – muss übersetzt werden.
// Regel: R-5.9, R-5.10, R-5.17
package konformitaet.kap05;

class Foo {
public:
    i32 value;
    constructor(i32 v) { this.value = v; }
    void run() { }
    void bump() & { this.value = this.value + 1; }
}

class Pair {
public:
    Foo left;
    Foo right;
    constructor(own Foo l, own Foo r) { this.left = l; this.right = r; }
}

class Borrows {
public:
    void swapValues(Foo& a, Foo& b) {
        i32 t = a.value;
        a.value = b.value;
        b.value = t;
    }

    i32 sum(Foo a, Foo b) { return a.value + b.value; }

    i32 total(Slice<i32> values) {
        i32 s = 0;
        for (i32 v : values) { s += v; }
        return s;
    }

    void demo() {
        Pair p = new Pair(new Foo(1), new Foo(2));
        // R-5.9, R-5.10: zwei veränderbare Borrows auf disjunkte Orte.
        swapValues(&p.left, &p.right);
        // Zwei lesende Borrows auf denselben Ort.
        i32 s = sum(p.left, p.left);
        // Der Slice lebt nur für die Dauer des Aufrufs.
        i32[] v = [1, 2, 3];
        i32 t = total(v[0..2]);
        v.push(4);
        // R-5.17: veränderbare und lesende Iteration.
        Foo[] list = [new Foo(1), new Foo(2)];
        for (Foo& f : &list) { f.bump(); }
        for (Foo f : list) { f.run(); }
        list.push(new Foo(3));
    }
}
