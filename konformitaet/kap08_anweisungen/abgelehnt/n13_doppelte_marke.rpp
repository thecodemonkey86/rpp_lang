// Konformitätstest Kapitel 8 – muss abgelehnt werden.
// Regel: R-8.24
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (die Marke 1 kommt zweimal vor).
package konformitaet.kap08;

class T {
public:
    void m(i32 n, f64 d, string s, bool flag) {
        switch (n) {
            case 1:
                print("a");
            case 2, 1: // FEHLER
                print("b");
            default:
                print("c");
        }
    }
}
