// Konformitätstest Kapitel 8 – muss abgelehnt werden.
// Regel: R-8.15
// Erwartet: genau ein Fehler, in der mit FEHLER markierten Zeile (isEmpty ist nodiscard).
package konformitaet.kap08;

class Stack {
public:
    i32[] items = [];
    nodiscard bool isEmpty() { return items.length == 0; }
}

class T {
public:
    void m(Stack s) {
        discard s.isEmpty(); // FEHLER
    }
}
